<%- include('partials/head') %>

    <div class="w-full max-w-md p-6 bg-surface border border-gray-800 rounded-2xl shadow-2xl relative z-10">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white tracking-tight mb-2">Forgot Password</h1>
            <p class="text-textSecondary text-sm">Enter your email to receive a reset link</p>
        </div>

        <% if (error) { %>
            <div
                class="bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-3 rounded-lg mb-6 text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <%= error %>
            </div>
            <% } %>

                <% if (message) { %>
                    <div
                        class="bg-green-500/10 border border-green-500/20 text-green-400 px-4 py-3 rounded-lg mb-6 text-sm flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7">
                            </path>
                        </svg>
                        <%= message %>
                    </div>
                    <% } %>

                        <form action="/forgot-password" method="POST" class="space-y-5">
                            <div class="group">
                                <label
                                    class="block text-xs font-medium text-textSecondary mb-1.5 uppercase tracking-wide">Email
                                    Address</label>
                                <div class="relative">
                                    <div
                                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-500">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207">
                                            </path>
                                        </svg>
                                    </div>
                                    <input type="email" name="email" required
                                        class="w-full bg-input border border-gray-800 rounded-lg pl-10 pr-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all"
                                        placeholder="you@example.com">
                                </div>
                            </div>

                            <button type="submit"
                                class="w-full bg-primary hover:bg-primary/90 text-white font-medium py-3 rounded-lg transition-transform transform active:scale-[0.98] shadow-lg shadow-primary/20">
                                Send Reset Link
                            </button>
                        </form>

                        <div class="mt-8 text-center text-sm text-textSecondary">
                            <p>Remember your password? <a href="/login"
                                    class="text-primary hover:text-white transition-colors">Sign In</a></p>
                        </div>
    </div>

    <%- include('partials/footer') %>