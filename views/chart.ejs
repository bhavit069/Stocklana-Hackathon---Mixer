                </p>

                <div class="space-y-2">
                  <% comp.forEach(function (c) { %>
                    <div class="fund-card-t" data-href="/mixer/<%= c.mixer_id %>">
                      <div class="flex items-start gap-3">
                        <img src="<%= c.image && c.image.trim() ? c.image : '/images/tokens/' + (c.topTokens[0] ? c.topTokens[0].address : 'none') %>"
                             alt="" class="w-9 h-9 rounded-lg object-cover border border-[#21262d] bg-[#0b0d10] shrink-0">
                        <div class="min-w-0 flex-1">
                          <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-sm font-semibold text-white truncate"><%= c.name %></span>
                            <span class="text-[10px] px-1.5 py-0.5 rounded bg-white/5 border border-[#21262d] text-gray-400"><%= c.ticker %></span>
                            <span class="text-[10px] px-1.5 py-0.5 rounded bg-[#7453E2]/15 border border-[#7453E2]/30 text-[#a78bfa]">Remix</span>
                            <% if (c.creatorHandle) { %>
                              <span class="text-[11px] text-gray-500">by <a
                                 href="https://x.com/<%= c.creatorHandle %>" target="_blank" rel="noopener"
                                 data-xcard="<%= c.creatorHandle %>"
                                 onclick="event.stopPropagation()"
                                 class="hover:text-[#2fbaff] transition-colors">@<%= c.creatorHandle %></a></span>
                            <% } %>
                          </div>

                          <% if (c.thesis_title) { %>
                            <p class="text-[12px] text-gray-300 mt-1 italic">&ldquo;<%= c.thesis_title %>&rdquo;</p>
                          <% } %>

                          <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                            <% c.topTokens.slice(0, 5).forEach(function (t) { %>
                              <span class="text-[10px] px-1.5 py-0.5 rounded bg-black/40 border border-[#21262d] text-gray-400">
                                <%= t.symbol %> <span class="text-gray-600"><%= (t.weight * 100).toFixed(0) %>%</span>
                              </span>
                            <% }) %>
                            <% if (c.tokenCount > 5) { %>
                              <span class="text-[10px] text-gray-600">+<%= c.tokenCount - 5 %></span>
                            <% } %>
                          </div>
                        </div>

                        <div class="text-right shrink-0">
                          <div class="text-sm font-semibold text-white tabular-nums">
                            <%= fmtSolC(c.netSol) %> <span class="text-[10px] text-gray-500 font-normal">SOL</span>
                          </div>
                          <div class="text-[10px] text-gray-500">
                            <%= c.investors %> investor<%= c.investors === 1 ? '' : 's' %>
                          </div>
                          <% if (c.change24h !== null && c.change24h !== undefined) { %>
                            <div class="text-[11px] font-semibold tabular-nums mt-1"
                                 style="color:<%= c.change24h >= 0 ? '#22c55e' : '#f6465d' %>">
                              <%= (c.change24h >= 0 ? '+' : '') + Number(c.change24h).toFixed(2) %>%
                            </div>
                          <% } else { %>
                            <div class="text-[11px] text-gray-600 mt-1">—</div>
                          <% } %>
                        </div>
                      </div>

                      <div class="flex items-center justify-between mt-2.5 pt-2.5 border-t border-[#21262d]">
                        <span class="text-[10px] text-gray-500">Since <%= agoDate(c.created_at) %></span>
                        <a href="/mixer/<%= c.mixer_id %>/compare/<%= mixer.mixer_id %>"
                           onclick="event.stopPropagation()"
                           class="text-[10px] text-[#a78bfa] hover:underline font-medium">Compare →</a>
                      </div>
                    </div>
                  <% }) %>
                </div>

                <p class="text-[10px] text-gray-600 mt-3 leading-relaxed">
                  Invested is net SOL in (deposits minus redemptions), not the current value of the vaults.
                  Mixers launched on different dates have run for different lengths of time, so 24h change is
                  shown rather than a since-inception return.
                </p>
              <% } else if (mixer.parent_mixer_id) { %>
                <p class="text-sm text-gray-500">
                  No one has remixed this yet.
                </p>
              <% } else { %>
                <div class="rounded-xl border border-dashed border-[#21262d] p-6 text-center">
                  <p class="text-sm text-gray-400">No competing theses yet.</p>
                  <p class="text-[12px] text-gray-600 mt-1 max-w-sm mx-auto leading-relaxed">
                    If you think this allocation is wrong, remix it: keep what you agree with,
                    change what you don't, and publish your own version.
                  </p>
                  <a href="/mixer/<%= mixer.mixer_id %>/remix"
                     class="inline-block mt-3 text-[12px] font-semibold px-4 py-2 rounded-lg bg-[#7453E2] hover:bg-[#6344d1] text-white transition-colors">
                    Remix this mixer
                  </a>
                </div>
              <% } %>
            </div>
            <% } %>

          </div>
        </div>

      </div>

      <div class="w-80 shrink-0 bg-[#0b0d10] border-l border-gray-800 overflow-y-auto hide-scrollbar">
        <div class="timeframe-container">

<div class="flex-1 flex flex-col items-center justify-center relative cursor-pointer" style="border-right: 1px solid #1f2937;">
	<span class="text-xs text-gray-300">5m</span>
	<% var tfv = null; try { tfv = timeframes.timeframes['5m'].change_percent; } catch (e) {} %>
	<span id="change-5m" class="timeframe-text <%= tfv == null ? 'price-neutral' : (tfv > 0 ? 'price-positive' : (tfv < 0 ? 'price-negative' : 'price-neutral')) %>">
		<%= tfv == null ? '—' : ((tfv >= 0 ? '+' : '') + Number(tfv).toFixed(2) + '%') %>
	</span>
</div>

<div class="flex-1 flex flex-col items-center justify-center cursor-pointer"  style="border-right: 1px solid #1f2937;">
	<span class="text-xs text-gray-300">1h</span>
	<% var tfv = null; try { tfv = timeframes.timeframes['1h'].change_percent; } catch (e) {} %>
	<span id="change-1h" class="timeframe-text <%= tfv == null ? 'price-neutral' : (tfv > 0 ? 'price-positive' : (tfv < 0 ? 'price-negative' : 'price-neutral')) %>">
		<%= tfv == null ? '—' : ((tfv >= 0 ? '+' : '') + Number(tfv).toFixed(2) + '%') %>
	</span>
</div>

<div class="flex-1 flex flex-col items-center justify-center cursor-pointer"  style="border-right: 1px solid #1f2937;">
	<span class="text-xs text-gray-300">6h</span>
	<% var tfv = null; try { tfv = timeframes.timeframes['6h'].change_percent; } catch (e) {} %>
	<span id="change-6h" class="timeframe-text <%= tfv == null ? 'price-neutral' : (tfv > 0 ? 'price-positive' : (tfv < 0 ? 'price-negative' : 'price-neutral')) %>">
		<%= tfv == null ? '—' : ((tfv >= 0 ? '+' : '') + Number(tfv).toFixed(2) + '%') %>
	</span>
</div>

<div class="flex-1 flex flex-col items-center justify-center cursor-pointer">
	<span class="text-xs text-gray-300">24h</span>
	<% var tfv = null; try { tfv = timeframes.timeframes['24h'].change_percent; } catch (e) {} %>
	<span id="change-24h" class="timeframe-text <%= tfv == null ? 'price-neutral' : (tfv > 0 ? 'price-positive' : (tfv < 0 ? 'price-negative' : 'price-neutral')) %>">
		<%= tfv == null ? '—' : ((tfv >= 0 ? '+' : '') + Number(tfv).toFixed(2) + '%') %>
	</span>
</div>

		</div>

		<div class="p-4" style="padding-bottom: 0;">

<div class="w-full text-[12px] px-3 pb-4">

  <%

    var rdRugged = (typeof riskDetail !== 'undefined' && riskDetail && riskDetail.rugged) || [];
    var rdHigh = (typeof riskDetail !== 'undefined' && riskDetail && riskDetail.highRisk) || [];
    var rdRuggedPct = (typeof riskDetail !== 'undefined' && riskDetail && riskDetail.ruggedWeight) || 0;
    var rdThin = (typeof riskDetail !== 'undefined' && riskDetail && riskDetail.thin) || [];
    var rdThinPct = (typeof riskDetail !== 'undefined' && riskDetail && riskDetail.thinWeight) || 0;
    var rdUnver = (typeof riskDetail !== 'undefined' && riskDetail && riskDetail.unverified) || [];

    var rdThinUnver = rdThin.filter(function (sym) { return rdUnver.indexOf(sym) !== -1; });
  %>
  <% if (rdRugged.length) { %>
    <div id="ruggedBanner" class="mb-3 rounded-[6px] border border-[#f6465d]/45 bg-[#f6465d]/10 px-3 py-2.5">
      <div class="flex items-start gap-2">
        <svg class="w-3.5 h-3.5 mt-[1px] shrink-0 text-[#f6465d]" fill="none" stroke="currentColor"
             stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 9v4m0 4h.01" stroke-linecap="round"/>
          <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
        </svg>
        <div class="min-w-0">
          <p class="text-[12px] font-semibold text-[#f6465d]">
            <%= rdRugged.length === 1 ? 'A token in this mixer is flagged as rugged'
                                      : rdRugged.length + ' tokens in this mixer are flagged as rugged' %>
          </p>
          <p class="text-[11px] text-textSecondary leading-snug mt-0.5">
            <%= rdRugged.join(', ') %><%= rdRuggedPct > 0 ? ' — ' + rdRuggedPct + '% of the basket' : '' %>.
            RugCheck reports this as a rug. Anything you buy here is exposed to it.
          </p>
        </div>
      </div>
    </div>
  <% } else if (rdHigh.length) { %>
    <div id="highRiskBanner" class="mb-3 rounded-[6px] border border-[#a16207]/40 bg-[#a16207]/10 px-3 py-2.5">
      <div class="flex items-start gap-2">
        <svg class="w-3.5 h-3.5 mt-[1px] shrink-0 text-[#eab308]" fill="none" stroke="currentColor"
             stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 9v4m0 4h.01" stroke-linecap="round"/>
          <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
        </svg>
        <div class="min-w-0">
          <p class="text-[12px] font-semibold text-[#eab308]">High-risk holdings</p>
          <p class="text-[11px] text-textSecondary leading-snug mt-0.5">
            <%= rdHigh.join(', ') %> rate 70 or above on RugCheck, in pools too
            thin to exit cleanly, or held by an unverified issuer with a live
            mint or freeze authority.
          </p>
        </div>
      </div>
    </div>
  <% } else if (rdThinUnver.length && rdThinPct >= 50) { %>
    <div id="thinBanner" class="mb-3 rounded-[6px] border border-[#a16207]/40 bg-[#a16207]/10 px-3 py-2.5">
      <div class="flex items-start gap-2">
        <svg class="w-3.5 h-3.5 mt-[1px] shrink-0 text-[#eab308]" fill="none" stroke="currentColor"
             stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 9v4m0 4h.01" stroke-linecap="round"/>
          <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
        </svg>
        <div class="min-w-0">
          <p class="text-[12px] font-semibold text-[#eab308]">Thinly traded basket</p>
          <p class="text-[11px] text-textSecondary leading-snug mt-0.5">
            <%= rdThinPct %>% of this basket sits in pools under $1M, and
            <%= rdThinUnver.join(', ') %> <%= rdThinUnver.length === 1 ? 'is' : 'are' %>
            unverified. Selling a position may move the price against you.
          </p>
        </div>
      </div>
    </div>
  <% } %>

  <% if (readiness.state !== 'ready') { %>
    <div id="readinessBanner"
         class="mb-3 rounded-[6px] border px-3 py-2.5 <%= readiness.tradeable
           ? 'border-[#a16207]/40 bg-[#a16207]/10'
           : 'border-[#7453E2]/35 bg-[#7453E2]/10' %>">
      <div class="flex items-start gap-2">
        <% if (readiness.tradeable) { %>
          <svg class="w-3.5 h-3.5 mt-[1px] shrink-0 text-[#eab308]" fill="none" stroke="currentColor"
               stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 9v4m0 4h.01" stroke-linecap="round"/>
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
          </svg>
        <% } else { %>
          <span class="relative flex h-2 w-2 mt-[5px] shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7453E2] opacity-70"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#7453E2]"></span>
          </span>
        <% } %>
        <div class="min-w-0">
          <p class="text-[11.5px] font-semibold <%= readiness.tradeable ? 'text-[#eab308]' : 'text-[#a78bfa]' %>">
            <%= readiness.state === 'pricing' ? 'Pricing in progress'
              : readiness.state === 'unpriceable' ? 'Not tradeable'
              : 'Partial pricing' %>
          </p>
          <p class="text-[11px] text-textSecondary leading-snug mt-0.5"><%= readiness.reason %></p>
        </div>
      </div>
    </div>
  <% } %>

  <div class="flex gap-1 mb-3 p-[3px] rounded-[6px] bg-[#101317] border border-primaryStroke">
    <button id="buyTab"
      class="flex-1 py-[7px] rounded-[4px] text-[12.5px] font-semibold transition-colors bg-[#16a34a] text-white">Buy</button>
    <button id="sellTab"
      class="flex-1 py-[7px] rounded-[4px] text-[12.5px] font-semibold transition-colors text-textSecondary hover:text-white">Sell</button>
  </div>

  <div class="relative flex mb-3 border-b border-primaryStroke">
    <button id="marketTab" class="flex-1 py-2 relative z-10 transition-colors duration-200 text-white text-[12px] font-medium">Market</button>
    <button id="limitTab" class="flex-1 py-2 relative z-10 transition-colors duration-200 text-textSecondary text-[12px] font-medium">Limit</button>
    <div id="tabIndicator" class="absolute bottom-0 h-[2px] bg-white transition-all duration-300 ease-in-out" style="width: 50%; left: 0%;"></div>
  </div>

  <div id="marketContent" class="flex flex-col gap-[10px]">

    <div class="flex flex-col">
      <div class="flex h-[40px] items-center rounded-t-[5px] border border-primaryStroke bg-[#15181e] pr-[12px] focus-within:border-[#7453E2] transition-colors">
        <div class="pl-[12px] pr-[4px]">
          <span class="text-[10px] font-semibold tracking-wider text-textTertiary">AMOUNT</span>
        </div>
        <div class="flex-1">
          <input id="marketAmount" type="text" inputmode="decimal" placeholder="0.00"
            class="w-full bg-transparent px-[8px] text-[15px] font-semibold text-textPrimary tabular-nums focus:outline-none placeholder-[#3d434b]">
        </div>

        <div class="flex items-center gap-1.5 shrink-0">
          <span id="marketUnitIcon" class="flex items-center justify-center w-[14px] h-[14px]">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 17.5 7 14h13l-3 3.5H4zM4 6.5 7 10h13L17 6.5H4zM4 12l3-3.5h13L17 12H4z" fill="#7453E2"/>
            </svg>
          </span>
          <span id="marketUnit" class="text-[11px] font-semibold text-textSecondary">SOL</span>
        </div>
      </div>

      <div id="marketQuick" class="flex h-[26px] rounded-b-[5px] border-x border-b border-primaryStroke text-[11px] text-textSecondary">
        <button onclick="setAmount('market',0.1)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">0.1</button>
        <button onclick="setAmount('market',0.5)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">0.5</button>
        <button onclick="setAmount('market',1)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">1</button>
        <button id="maxBtn" onclick="setMaxAmount()" class="flex-1 hover:bg-primaryStroke hover:text-white transition-colors font-medium">MAX</button>
      </div>
      <p id="minTradeHint" class="mt-1.5 text-[10.5px] text-textTertiary tabular-nums min-h-[14px]"></p>
    </div>

    <button id="marketButton"
      class="h-[42px] w-full rounded-[5px] text-[13px] font-semibold bg-[#16a34a] hover:bg-[#15803d] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
      Buy Market
    </button>
  </div>

  <div id="limitContent" class="flex flex-col gap-[10px] hidden">

    <div class="flex flex-col">
      <div class="flex h-[40px] items-center rounded-t-[5px] border border-primaryStroke bg-[#15181e] pr-[12px] focus-within:border-[#7453E2] transition-colors">
        <div class="pl-[12px] pr-[4px]">
          <span class="text-[10px] font-semibold tracking-wider text-textTertiary">AMOUNT</span>
        </div>
        <div class="flex-1">
          <input id="limitAmount" type="text" inputmode="decimal" placeholder="0.00"
            class="w-full bg-transparent px-[8px] text-[15px] font-semibold text-textPrimary tabular-nums focus:outline-none placeholder-[#3d434b]">
        </div>
        <span id="limitUnit" class="text-[11px] font-semibold text-textSecondary shrink-0">SOL</span>
      </div>

      <div id="limitQuick" class="flex h-[26px] rounded-b-[5px] border-x border-b border-primaryStroke text-[11px] text-textSecondary">
        <button onclick="setAmount('limit',0.1)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">0.1</button>
        <button onclick="setAmount('limit',0.5)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">0.5</button>
        <button onclick="setAmount('limit',1)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">1</button>
        <button onclick="setAmount('limit',5)" class="flex-1 hover:bg-primaryStroke hover:text-white transition-colors">5</button>
      </div>
    </div>

    <div class="flex flex-col">
      <div class="flex h-[40px] items-center rounded-t-[5px] border border-primaryStroke bg-[#15181e] pr-[12px] focus-within:border-[#7453E2] transition-colors">
        <div class="pl-[12px] pr-[4px]">
          <span class="text-[10px] font-semibold tracking-wider text-textTertiary">TRIGGER</span>
        </div>
        <div class="flex-1">
          <input id="limitPrice" type="text" inputmode="decimal" placeholder="0.00"
            class="w-full bg-transparent px-[8px] text-[15px] font-semibold text-textPrimary tabular-nums focus:outline-none placeholder-[#3d434b]">
        </div>
        <span class="text-[11px] font-semibold text-textSecondary shrink-0">USD</span>
      </div>

      <div class="flex h-[26px] rounded-b-[5px] border-x border-b border-primaryStroke text-[11px] text-textSecondary">
        <button onclick="offsetLimit(-10)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">-10%</button>
        <button onclick="offsetLimit(-5)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">-5%</button>
        <button onclick="offsetLimit(5)" class="flex-1 border-r border-primaryStroke hover:bg-primaryStroke hover:text-white transition-colors">+5%</button>
        <button onclick="offsetLimit(10)" class="flex-1 hover:bg-primaryStroke hover:text-white transition-colors">+10%</button>
      </div>
      <p id="limitHint" class="text-[10px] text-textTertiary mt-1.5 leading-snug"></p>
    </div>

    <button id="limitButton"
      class="h-[42px] w-full rounded-[5px] text-[13px] font-semibold bg-[#7453E2] hover:bg-[#6344d1] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
      Place Limit Order
    </button>
  </div>

</div>
</div>

  <div id="pnlStrip" class="flex flex-1 flex-row items-center justify-center border-t border-primaryStroke">
    <div class="flex max-h-[64px] min-h-[64px] flex-1 flex-row items-center justify-center py-[8px]">

      <div class="flex flex-1 flex-col items-center justify-center gap-[4px]">
        <span class="text-[12px] font-normal leading-[16px] text-textTertiary">Bought</span>
        <div class="flex flex-row items-center gap-[4px]">
          <div class="flex items-center justify-center gap-[4px]">
            <span id="pnlBought" class="text-[12px] font-medium leading-[16px] text-textSecondary tabular-nums">&mdash;</span>
          </div>
        </div>
      </div>

      <div class="h-[48px] w-[1px] bg-primaryStroke"></div>

      <div class="flex flex-1 flex-col items-center justify-center gap-[4px]">
        <span class="text-[12px] font-normal leading-[16px] text-textTertiary">Sold</span>
        <div class="flex flex-row items-center gap-[4px]">
          <div class="flex items-center justify-center gap-[4px]">
            <span id="pnlSold" class="text-[12px] font-medium leading-[16px] text-textSecondary tabular-nums">&mdash;</span>
          </div>
        </div>
      </div>

      <div class="h-[48px] w-[1px] bg-primaryStroke"></div>

      <div class="flex flex-1 flex-col items-center justify-center gap-[4px]">
        <span class="text-[12px] font-normal leading-[16px] text-textTertiary">Holding</span>
        <div class="flex flex-row items-center gap-[4px]">
          <div class="flex items-center justify-center gap-[4px]">
            <span id="pnlHolding" class="text-[12px] font-medium leading-[16px] text-textSecondary tabular-nums">&mdash;</span>
          </div>
        </div>
      </div>

      <div class="h-[48px] w-[1px] bg-primaryStroke"></div>

      <div class="flex min-w-[116px] flex-col items-center justify-center gap-[4px] px-[4px]">
        <div class="flex h-[16px] flex-row items-center justify-center">
          <button type="button" id="pnlUnitToggle" onclick="togglePnlUnit()"
                  title="Switch between SOL and USD"
                  class="group flex flex-row items-center justify-center gap-[4px] rounded-[4px] px-[6px] pl-[8px]
                         transition-colors duration-150 ease-in-out hover:cursor-pointer hover:bg-primaryStrokeHalf
                         disabled:cursor-not-allowed disabled:opacity-50">
            <span class="text-[12px] font-normal leading-[16px] text-textTertiary transition-colors duration-150 ease-in-out group-hover:text-textSecondary">PnL</span>

            <i class="ri-exchange-dollar-line text-[14px] text-textTertiary transition-colors duration-150 ease-in-out"></i>
          </button>
        </div>
        <div class="flex items-center justify-center gap-[4px]">
          <span id="pnlValue" class="text-nowrap text-[12px] font-medium leading-[16px] text-textSecondary tabular-nums">&mdash;</span>
        </div>
      </div>

    </div>
  </div>

<div class="p-4" style="padding-top: 0;">
<div class="w-full text-[12px] px-3 pb-4">

  <div class="mt-4 pt-3 border-t border-primaryStroke">
    <p class="text-[10px] uppercase tracking-wider text-textTertiary font-semibold mb-2">Basket</p>
    <div class="flex flex-col gap-[6px]">
      <% allocations.forEach(function (a) {
           var tp = (typeof tokenPrices !== 'undefined' && tokenPrices) ? tokenPrices[a.token_address] : undefined; %>
        <div class="flex items-center gap-1.5 group/tok">
          <img src="/images/tokens/<%= a.token_address %>" alt="" class="w-4 h-4 rounded-full bg-[#0b0d10] shrink-0" loading="lazy">
          <span class="text-[11px] text-textSecondary truncate"><%= a.token?.symbol || a.token_address.slice(0, 4) %></span>

          <% if (a.token && a.token.is_verified) { %>

            <svg width="11.5" height="11.5" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"
                 class="shrink-0" style="color:#82e58a" aria-label="Verified on jup.ag">
              <g clip-path="url(#clip_basket_verified)">
                <path d="M5.24996 7.00001L6.41663 8.16668L9.04163 5.54168M10.4423 2.9158C10.5624 3.20632 10.793 3.43724 11.0833 3.5578L12.1013 3.9795C12.3919 4.09984 12.6227 4.33067 12.743 4.62121C12.8634 4.91175 12.8634 5.23819 12.743 5.52873L12.3217 6.54606C12.2013 6.83673 12.2011 7.1635 12.322 7.45403L12.7427 8.47106C12.8023 8.61496 12.8331 8.7692 12.8331 8.92498C12.8331 9.08075 12.8024 9.23501 12.7428 9.37893C12.6832 9.52285 12.5958 9.65361 12.4857 9.76374C12.3755 9.87388 12.2447 9.96122 12.1008 10.0208L11.0835 10.4422C10.793 10.5623 10.5621 10.7929 10.4415 11.0832L10.0198 12.1013C9.8995 12.3918 9.66868 12.6226 9.37816 12.743C9.08763 12.8633 8.76119 12.8633 8.47067 12.743L7.45337 12.3216C7.16284 12.2015 6.83652 12.2018 6.54617 12.3223L5.52815 12.7434C5.23778 12.8634 4.91163 12.8633 4.62134 12.7431C4.33105 12.6228 4.10036 12.3923 3.97993 12.1021L3.55813 11.0837C3.43801 10.7932 3.20744 10.5623 2.91712 10.4417L1.8991 10.02C1.6087 9.8997 1.37794 9.66902 1.25756 9.37865C1.13717 9.08828 1.13701 8.76198 1.2571 8.47149L1.67848 7.45416C1.79852 7.16362 1.79828 6.83729 1.6778 6.54692L1.25703 5.52813C1.19737 5.38423 1.16665 5.22999 1.16663 5.07421C1.1666 4.91843 1.19727 4.76418 1.25688 4.62026C1.31649 4.47634 1.40388 4.34558 1.51404 4.23545C1.6242 4.12532 1.75499 4.03797 1.89892 3.9784L2.91622 3.55701C3.20647 3.43699 3.43724 3.20671 3.55789 2.91671L3.97957 1.89865C4.09991 1.60811 4.33073 1.37728 4.62126 1.25693C4.91178 1.13659 5.23822 1.13659 5.52874 1.25693L6.54604 1.67833C6.83657 1.79837 7.16289 1.79813 7.45324 1.67764L8.47169 1.25759C8.76218 1.13731 9.08854 1.13734 9.37901 1.25766C9.66948 1.37798 9.90028 1.60874 10.0206 1.8992L10.4424 2.91757L10.4423 2.9158Z"
                      stroke="currentColor" stroke-width="1.3125" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
              <defs><clipPath id="clip_basket_verified"><rect width="14" height="14" fill="currentColor"/></clipPath></defs>
            </svg>
          <% } %>

          <button type="button"
                  class="tok-copy shrink-0 text-textTertiary hover:text-white opacity-0 group-hover/tok:opacity-100 transition-opacity"
                  data-address="<%= a.token_address %>"
                  aria-label="Copy address for <%= a.token?.symbol || a.token_address.slice(0, 4) %>">
            <svg class="w-[11px] h-[11px]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/>
              <path d="M10.5 5.5v-2a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3.5v5.5a1.5 1.5 0 0 0 1.5 1.5h2"/>
            </svg>
          </button>

          <span class="flex-1"></span>

          <span class="text-[11px] tabular-nums text-textTertiary">
            <% if (tp !== undefined && tp !== null) { %>$<%= fmtPrice(tp) %><% } else { %><span class="text-[#5a616b]">no price</span><% } %>
          </span>
          <span class="text-[11px] tabular-nums text-white font-medium w-[38px] text-right"><%= (Number(a.weight) * 100).toFixed(0) %>%</span>
        </div>
      <% }); %>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-primaryStroke">

    <%

      var hasCompetition = !!(mixer.parent_mixer_id || mixer.parent_name)
        || !!(typeof remixCount !== 'undefined' && remixCount > 0)
        || !!(typeof competition !== 'undefined' && competition && competition.total > 1);
    %>
    <div class="flex items-center justify-between mb-2">
      <p class="text-[10px] uppercase tracking-wider text-textTertiary font-semibold">
        <%= hasCompetition ? 'Competition' : 'Thesis' %>
      </p>
      <% if (typeof competition !== 'undefined' && competition && competition.rank) { %>
        <span class="comp-rank <%= competition.isLeader ? 'is-leader' : '' %>">
          <% if (competition.isLeader) { %>
            <svg class="w-[9px] h-[9px]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/>
            </svg>
            Leading
          <% } else { %>
            #<%= competition.rank %><span class="opacity-50">/<%= competition.total %></span>
          <% } %>
        </span>
      <% } %>
    </div>

    <%
      var hasParent = !!(mixer.parent_mixer_id || mixer.parent_name);
      var rc = (typeof remixCount !== 'undefined') ? remixCount : 0;
      var comp = (typeof competition !== 'undefined') ? competition : null;

      var thesisTitle = mixer.thesis_title || '';
      var thesisBody  = mixer.thesis || '';
      var counter     = mixer.counter_thesis || '';

      var LONG = 180;
      var bodyLong = thesisBody.length > LONG;
      var counterLong = counter.length > LONG;
    %>

    <div class="comp-card">
      <div class="flex items-center gap-1.5 mb-1.5">
        <svg class="w-3 h-3 shrink-0" style="color:#a78bfa" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18h6M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/>
        </svg>
        <span class="comp-eyebrow"><%= hasParent ? 'The counter-argument' : 'The thesis' %></span>
      </div>

      <% if (thesisTitle) { %>
        <p class="text-[12.5px] font-semibold text-white leading-snug"><%= thesisTitle %></p>
      <% } else { %>
        <p class="text-[12.5px] font-semibold text-white leading-snug"><%= mixer.name %></p>
      <% } %>

      <% if (thesisBody) { %>
        <p class="comp-body mt-1"><%= bodyLong ? thesisBody.slice(0, LONG).trim() + '…' : thesisBody %></p>
      <% } else if (!thesisTitle) { %>
        <p class="text-[11px] text-[#5a616b] italic mt-1">No thesis was written for this mixer.</p>
      <% } %>

      <% if (counter) { %>
        <div class="mt-2 pt-2" style="border-top:1px solid #1b1f26">
          <span class="comp-eyebrow" style="color:#f0883e">Why the original is wrong</span>
          <p class="comp-body mt-1"><%= counterLong ? counter.slice(0, LONG).trim() + '…' : counter %></p>
        </div>
      <% } %>

      <%

        var siteHost = null;
        try {
          if (mixer.website && /^https?:\/\//i.test(mixer.website)) {
            siteHost = new URL(mixer.website).hostname.replace(/^www\./, '');
          }
        } catch (e) { siteHost = null; }
      %>
      <% if (siteHost) { %>
        <a href="<%= mixer.website %>" target="_blank" rel="noopener noreferrer nofollow ugc"
           class="thesis-site mt-2" title="<%= mixer.website %>">
          <svg class="w-[11px] h-[11px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span class="truncate">Read more on <%= siteHost %></span>
          <span aria-hidden="true">&#8599;</span>
        </a>
      <% } %>

      <% if (bodyLong || counterLong) { %>
        <button type="button" onclick="openThesis()" class="comp-more">
          View more
          <svg class="w-[9px] h-[9px]" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6l6 6-6 6"/>
          </svg>
        </button>
      <% } %>
    </div>

    <% if (hasParent) { %>
      <div class="comp-card mt-1.5">
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 shrink-0" style="color:#a78bfa" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>
            <path d="M18 9a9 9 0 0 1-9 9"/>
          </svg>
          <div class="min-w-0 flex-1">
            <div class="comp-eyebrow">Remixed from</div>
            <% if (mixer.parent_mixer_id) { %>
              <a href="/mixer/<%= mixer.parent_mixer_id %>"
                 class="text-[12px] font-semibold text-[#a78bfa] hover:underline truncate block">
                <%= mixer.parent_name || 'the original' %>
              </a>
            <% } else { %>
              <span class="text-[12px] font-semibold text-gray-400 truncate block"><%= mixer.parent_name %></span>
            <% } %>
          </div>
          <% if (mixer.parent_mixer_id) { %>
            <a href="/mixer/<%= mixer.mixer_id %>/compare/<%= mixer.parent_mixer_id %>"
               class="comp-link shrink-0">Diff</a>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (comp && comp.total > 1) { %>
      <a href="/competition/<%= comp.rootId %>" class="comp-card comp-card-btn mt-1.5 block">
        <div class="flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[12px] font-semibold text-white">
              <%= comp.total %> baskets competing
            </div>
            <p class="text-[10.5px] text-textTertiary mt-0.5 leading-snug">
              <% if (comp.isLeader) { %>
                This one is winning.
              <% } else if (comp.rank) { %>
                This one sits <%= comp.rank %><%=
                  comp.rank === 1 ? 'st' : comp.rank === 2 ? 'nd' : comp.rank === 3 ? 'rd' : 'th'
                %>.
              <% } else { %>
                See how they rank.
              <% } %>
            </p>
          </div>
