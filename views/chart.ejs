  <div id="performance-fullscreen-modal" class="hidden fixed inset-0 bg-black bg-opacity-95 z-50">
    <div class="h-full flex flex-col">
      <div class="bg-[#0b0d10] border-b border-gray-800 px-6 py-4 flex items-center justify-between">
        <h2 class="text-xl font-semibold text-white">Token Performance - Fullscreen</h2>
        <button
          onclick="togglePerformanceFullscreen()"
          class="px-3 py-1.5 bg-[#1a1a1a] hover:bg-[#222] text-white rounded-md text-sm transition">
          Close
