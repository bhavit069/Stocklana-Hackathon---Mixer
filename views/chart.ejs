  <script>
    const MIXER_ID = "<%= mixer.mixer_id %>";
    window.MIXER_ID = MIXER_ID;
    const TOKENS = <%- JSON.stringify(allocations.map(a => a.token_address)) %>;
    const ALLOCATIONS = <%- JSON.stringify(allocations) %>;
    const PERFORMANCE_DATA = <%- JSON.stringify(performance) %>;
    const READINESS = <%- JSON.stringify(readiness) %>;
    window.READINESS = READINESS;

    const pageLoadTime = Date.now();

    function updateLastUpdatedTime() {
      const now = Date.now();
      const elapsed = Math.floor((now - pageLoadTime) / 1000);
      let timeStr = elapsed === 0 ? 'Just now' : elapsed < 60 ? `${elapsed}s ago` : elapsed < 3600 ? `${Math.floor(elapsed / 60)}m ago` : `${Math.floor(elapsed / 3600)}h ago`;
      const elem = document.getElementById('last-updated');
      if (elem) elem.textContent = timeStr;
    }

    setInterval(updateLastUpdatedTime, 1000);

    function copyToClipboard(text) {
      navigator.clipboard.writeText(text);
    }

    function openThesis() {
      const m = document.getElementById('thesisModal');
      if (!m) return;
      m.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeThesis() {
      const m = document.getElementById('thesisModal');
      if (!m) return;
      m.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      const m = document.getElementById('thesisModal');
      if (m && m.classList.contains('is-open')) closeThesis();
    });

    (function liveHeaderStats() {
      const POLL_MS = 15000;

      const SIR_BASE = <%- JSON.stringify(
        (typeof sirBase !== 'undefined' && sirBase !== null) ? sirBase : null
      ) %>;

      window.updateSirFromPrice = function (price) {
        const el = document.getElementById('sir-stat');
        if (!el || !SIR_BASE || !isFinite(price) || price <= 0) return;

        const v = (price / SIR_BASE - 1) * 100;
        const txt = (v >= 0 ? '+' : '') + v.toFixed(2) + '%';
        if (el.textContent.trim() === txt) return;

        el.textContent = txt;
        el.style.color = v >= 0 ? '#22c55e' : '#f6465d';
      };

      function put(id, text, colourClass) {
        const el = document.getElementById(id);
        if (!el) return;

        const next = String(text);
        if (el.textContent.trim() === next.trim()) {

          if (colourClass !== undefined) applyClass(el, colourClass);
          return;
        }

        el.textContent = next;
        if (colourClass !== undefined) applyClass(el, colourClass);

        el.classList.remove('stat-flash');
        void el.offsetWidth;
        el.classList.add('stat-flash');
      }

      function applyClass(el, cls) {
        el.classList.remove('price-positive', 'price-negative', 'price-neutral');
        if (cls) el.classList.add(cls);
      }

      function pct(v) {
        if (v === null || v === undefined || !isFinite(v)) return '—';
        return (v >= 0 ? '+' : '') + Number(v).toFixed(2) + '%';
      }

      function cls(v) {
        if (v === null || v === undefined || !isFinite(v)) return 'price-neutral';
        return v > 0 ? 'price-positive' : (v < 0 ? 'price-negative' : 'price-neutral');
      }

      async function tick() {
        let d;
        try {
          const r = await fetch('/mixer/' + MIXER_ID + '/live-stats',
                                { headers: { Accept: 'application/json' } });
          if (!r.ok) return;
          d = await r.json();
          if (!d || !d.ok) return;
        } catch {
          return;
        }

        const ch = d.changes || {};
        put('change-5m', pct(ch['5m']), cls(ch['5m']));
        put('change-1h', pct(ch['1h']), cls(ch['1h']));
        put('change-6h', pct(ch['6h']), cls(ch['6h']));
        put('change-24h', pct(ch['24h']), cls(ch['24h']));

        put('change-24h-stat', pct(ch['24h']), cls(ch['24h']));

        if (d.volume24h !== null && d.volume24h !== undefined) {
          put('volume-24h', Number(d.volume24h).toFixed(3));
        }
        if (d.holders !== null && d.holders !== undefined) {
          put('holders-stat', String(d.holders));
        }

        const sirEl = document.getElementById('sir-stat');
        if (sirEl && d.sir !== null && d.sir !== undefined && isFinite(d.sir)) {
          const txt = pct(d.sir);
          if (sirEl.textContent.trim() !== txt) {
            sirEl.textContent = txt;
            sirEl.style.color = d.sir >= 0 ? '#22c55e' : '#f6465d';
            sirEl.classList.remove('stat-flash');
            void sirEl.offsetWidth;
            sirEl.classList.add('stat-flash');
          }
        }
      }

      let timer = null;
      function start() {
        if (timer) return;
        tick();
        timer = setInterval(tick, POLL_MS);
      }
      function stop() {
        if (!timer) return;
        clearInterval(timer);
        timer = null;
      }

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop(); else start();
      });

      start();
    })();

    function shareMixer(btn) {
      var url = window.location.origin + '/mixer/' + MIXER_ID;
      var title = <%- JSON.stringify(mixer.ticker + ' — ' + mixer.name) %>;

      function copied() {
        var original = btn.innerHTML;
        btn.innerHTML =
          '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
          'stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(function () { btn.innerHTML = original; }, 1400);
      }

      if (navigator.share) {
        navigator.share({ title: title, url: url })
          .catch(function () {  });
        return;
      }
      navigator.clipboard.writeText(url).then(copied).catch(function () {});
    }

    function copyTokenAddress(event, address) {
      event.preventDefault();
      event.stopPropagation();

      const btn = event.currentTarget;
      navigator.clipboard.writeText(address).then(() => {
        const original = btn.innerHTML;
        btn.classList.add('copied');
        btn.innerHTML =
          '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
          'stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
          '<polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = original;
        }, 1200);
      });
    }

    (function () {
      var tip = null;

      function ensureTip() {
        if (tip) return tip;
        tip = document.createElement('div');
        tip.style.cssText = [
          'position:fixed', 'z-index:80', 'display:none', 'pointer-events:none',
          'background:#14161B', 'border:1px solid #2C2C2C', 'border-radius:6px',
          'padding:5px 8px', 'box-shadow:0 6px 18px rgba(0,0,0,.5)',
          'font-size:10.5px', 'color:#e5e7eb', 'white-space:nowrap',
        ].join(';');
        document.body.appendChild(tip);
        return tip;
      }

      function tipTarget(e) {
        if (!e.target.closest) return null;
        return e.target.closest('.tok-copy, [data-tip]');
      }

      document.addEventListener('mouseover', function (e) {
        var btn = tipTarget(e);
        if (!btn) return;
        var text = btn.dataset.tip || btn.dataset.address || '';
        if (!text) return;

        var t = ensureTip();
        t.textContent = text;

        t.style.fontFamily = btn.dataset.tip ? 'inherit' : 'ui-monospace,monospace';
        t.style.display = 'block';
        var r = btn.getBoundingClientRect();

        t.style.top = (r.top - t.offsetHeight - 6) + 'px';
        t.style.left = Math.max(6, r.left + r.width / 2 - t.offsetWidth / 2) + 'px';
      });

      document.addEventListener('mouseout', function (e) {
        if (tipTarget(e) && tip) tip.style.display = 'none';
      });

      document.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.tok-copy') : null;
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        if (tip) tip.style.display = 'none';
        copyTokenAddress({
          preventDefault: function () {},
          stopPropagation: function () {},
          currentTarget: btn,
        }, btn.dataset.address);
      });
    })();

    const TF_LABEL = {
      15: '15s', 30: '30s', 60: '1m', 300: '5m',
      900: '15m', 1800: '30m', 3600: '1h', 14400: '4h',
    };

    function switchTimeframe(seconds) {
      if (window.changeTimeframe) window.changeTimeframe(seconds);

      const label = document.getElementById('tfLabel');
      if (label) label.textContent = TF_LABEL[seconds] || (seconds + 's');

      document.querySelectorAll('#tfPop .ct-item').forEach(function (b) {
        b.classList.toggle('is-active', Number(b.dataset.tf) === Number(seconds));
      });

      try { localStorage.setItem('mixer.tf', String(seconds)); } catch {  }
    }

    (function chartToolbar() {

      const menus = [
        { trigger: 'tfTrigger', pop: 'tfPop' },
        { trigger: 'styleTrigger', pop: 'stylePop' },
      ];

      function closeAll(except) {
        menus.forEach(function (m) {
          if (m.pop === except) return;
          const p = document.getElementById(m.pop);
          const t = document.getElementById(m.trigger);
          if (p) p.classList.remove('is-open');
          if (t) { t.classList.remove('is-open'); t.setAttribute('aria-expanded', 'false'); }
        });
      }

      menus.forEach(function (m) {
        const trigger = document.getElementById(m.trigger);
        const pop = document.getElementById(m.pop);
        if (!trigger || !pop) return;

        trigger.addEventListener('click', function (e) {
          e.stopPropagation();
          const open = pop.classList.contains('is-open');
          closeAll(m.pop);
          pop.classList.toggle('is-open', !open);
          trigger.classList.toggle('is-open', !open);
          trigger.setAttribute('aria-expanded', String(!open));
        });
      });

      document.addEventListener('click', function () { closeAll(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAll();
      });

      const tfPop = document.getElementById('tfPop');
      if (tfPop) {
        tfPop.addEventListener('click', function (e) {
          const item = e.target.closest('.ct-item');
          if (!item) return;
          switchTimeframe(Number(item.dataset.tf));
          closeAll();
        });
      }

      const stylePop = document.getElementById('stylePop');
      if (stylePop) {
        stylePop.addEventListener('click', function (e) {
          const item = e.target.closest('.ct-item');
          if (!item) return;
          setChartStyle(item.dataset.style);
          closeAll();
        });
      }

      function setChartStyle(style) {
        if (window.setChartStyle) window.setChartStyle(style);

        document.querySelectorAll('#stylePop .ct-item').forEach(function (b) {
          b.classList.toggle('is-active', b.dataset.style === style);
        });

        const chosen = document.querySelector('#stylePop .ct-item[data-style="' + style + '"] .ct-glyph');
        const icon = document.getElementById('styleIcon');
        if (chosen && icon) icon.innerHTML = chosen.innerHTML;

        try { localStorage.setItem('mixer.chartStyle', style); } catch {  }
      }

      function restore() {
        let tf = 15, style = 'candles';
        try {
          tf = Number(localStorage.getItem('mixer.tf')) || 15;
          style = localStorage.getItem('mixer.chartStyle') || 'candles';
        } catch {  }

        if (window.changeTimeframe) switchTimeframe(tf);
        else document.querySelectorAll('#tfPop .ct-item').forEach(function (b) {
          b.classList.toggle('is-active', Number(b.dataset.tf) === tf);
        });

        if (window.setChartStyle) setChartStyle(style);
      }

      if (window.setChartStyle) restore();
      else window.addEventListener('mixerchart:ready', restore, { once: true });
    })();

    function switchTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
      document.querySelectorAll('.tab-button').forEach(button => button.classList.remove('active'));
      document.getElementById(`tab-${tabName}`).classList.remove('hidden');
      document.querySelector(`[data-tab="${tabName}"]`).classList.add('active');

      if (tabName === 'allocations' && !window.pieChartInitialized) {
        initPieChart();
      }

      if (tabName === 'position' && window.refreshHoldings) {
        window.refreshHoldings();
      }

      if (tabName === 'holders' && window.MixerLive) {
        window.MixerLive.loadHolders();
      }

      if (tabName === 'performance' && !window.performanceChartInitialized) {
        setTimeout(() => {
          initPerformanceChart(PERFORMANCE_DATA);
          window.performanceChartInitialized = true;
        }, 100);
      }
    }

    document.querySelectorAll('.fund-card-t').forEach(function (el) {
      el.addEventListener('click', function () {
        if (el.dataset.href) window.location.href = el.dataset.href;
      });
    });

    function initPieChart() {
      const ctx = document.getElementById('allocation-pie-chart');
      if (!ctx) return;

      const colors = ['#8b5cf6', '#ec4899', '#10b981', '#f59e0b', '#3b82f6', '#ef4444'];
      const labels = ALLOCATIONS.map((a) => a.token?.symbol || a.token?.name || 'Unknown');
      const weights = ALLOCATIONS.map(a => (a.weight || 0) * 100);

      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: weights,
            backgroundColor: colors.slice(0, ALLOCATIONS.length),
            borderColor: '#0B0D10',
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0b0d10',
              titleColor: '#C9D1D9',
              bodyColor: '#C9D1D9',
              borderColor: '#2d3748',
              borderWidth: 1
            }
          }
        }
      });

      window.pieChartInitialized = true;
    }

    (function() {
      const adjuster = document.getElementById('chart-adjuster');
      const chartContainer = document.getElementById('chart-container');
      let isResizing = false;
      let startY = 0;
      let startHeight = 0;

      adjuster.addEventListener('mousedown', (e) => {
        isResizing = true;
        startY = e.clientY;
        startHeight = chartContainer.offsetHeight;
        document.body.style.cursor = 'ns-resize';
        document.body.style.userSelect = 'none';
        e.preventDefault();
      });

      document.addEventListener('mousemove', (e) => {
        if (!isResizing) return;
        const delta = e.clientY - startY;
        const newHeight = Math.max(300, Math.min(800, startHeight + delta));
        chartContainer.style.height = newHeight + 'px';
      });

      document.addEventListener('mouseup', () => {
        if (isResizing) {
          isResizing = false;
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
        }
      });
    })();
  </script>
  <script src="/js/mixerChart.js"></script>
  <script src="/js/tokenPerformanceChart.js"></script>
  <script>

    let side = "buy";
    let type = "market";

    let limitOrderPriceLine = null;

    const buyTab = document.getElementById("buyTab");
    const sellTab = document.getElementById("sellTab");
    const marketTab = document.getElementById("marketTab");
    const limitTab = document.getElementById("limitTab");

    const marketContent = document.getElementById("marketContent");
    const limitContent = document.getElementById("limitContent");

    let livePriceEl = document.getElementById("live-mixer-price");
    if (!livePriceEl) {
      livePriceEl = document.createElement("div");
      livePriceEl.id = "live-mixer-price";
      livePriceEl.style.display = "none";
      livePriceEl.innerText = "0.5000";
      document.body.appendChild(livePriceEl);
    }

    function getBasePrice() {
      const el = document.getElementById("live-mixer-price");
      const n = el ? parseFloat(String(el.innerText).replace(/[^0-9eE.+-]/g, '')) : NaN;

      return Number.isFinite(n) && n > 0 ? n : 0;
    }

    function updateLimitOrderLine(price) {
      if (!window.candleSeries) {
        console.warn('Chart not initialized yet');
        return;
      }

      if (limitOrderPriceLine) {
        try { window.candleSeries.removePriceLine(limitOrderPriceLine); } catch {  }
        limitOrderPriceLine = null;
      }

      if (price && price > 0) {
        const lineColor = side === 'buy' ? '#22c55e' : '#f6465d';

        limitOrderPriceLine = window.candleSeries.createPriceLine({
          price: price,
          color: lineColor,
          lineWidth: 2,
          lineStyle: LightweightCharts.LineStyle.Dashed,
          axisLabelVisible: true,
          title: `${side === 'buy' ? 'Buy' : 'Sell'} Limit @ $${price.toFixed(4)}`,
        });
      }
    }

    function removeLimitOrderLine() {
      if (limitOrderPriceLine && window.candleSeries) {
        try { window.candleSeries.removePriceLine(limitOrderPriceLine); } catch {  }
        limitOrderPriceLine = null;
      }
    }

    window.addEventListener('mixerchart:serieschanged', function () {
      limitOrderPriceLine = null;
      var input = document.getElementById('limitPrice');
      var price = input ? parseFloat(input.value) : NaN;
      if (isFinite(price) && price > 0) updateLimitOrderLine(price);
    });

    const MIXER_TICKER = <%- JSON.stringify(mixer.ticker) %>;
    const MIXER_IMAGE = <%- JSON.stringify((mixer.image && mixer.image.trim()) ? mixer.image : '/images/tokens/' + (allocations[0] ? allocations[0].token_address : 'none')) %>;

    let SOL_ICON_HTML = null;
    let lastUnitSide = null;

    function syncAmountUnit() {
      const icon = document.getElementById('marketUnitIcon');
      const label = side === 'sell' ? MIXER_TICKER : 'SOL';

      const hint = document.getElementById('minTradeHint');
      if (hint && window.mixerMinTrade) {
        window.mixerMinTrade().then(function (m) {
          if (!m) return;
          hint.textContent = side === 'sell'
            ? 'Minimum sell $' + m.usd + ' (≈' + m.sol.toFixed(4) + ' SOL), or your whole position'
            : 'Minimum buy $' + m.usd + ' (≈' + m.sol.toFixed(4) + ' SOL)';
        });
      }

      if (icon && SOL_ICON_HTML === null) SOL_ICON_HTML = icon.innerHTML;

      ['marketUnit', 'limitUnit'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el && el.textContent !== label) el.textContent = label;
      });

      if (icon && icon.dataset.unit !== label) {
        icon.dataset.unit = label;
        icon.innerHTML = side === 'sell'
          ? '<img src="' + MIXER_IMAGE + '" alt="" class="w-[14px] h-[14px] rounded-full object-cover">'
          : SOL_ICON_HTML;
      }

      if (lastUnitSide !== null && lastUnitSide !== side) {
        ['marketAmount', 'limitAmount'].forEach(function (id) {
          const el = document.getElementById(id);
          if (el) el.value = '';
        });
      }
      lastUnitSide = side;
    }

    window.focusBuy = function () {
      if (side !== 'buy') buyTab.onclick();
      if (type !== 'market') marketTab.onclick();
      const input = document.getElementById('marketAmount');
      if (input) { input.focus(); input.select(); }
    };

    function unitsToPercent(amount) {
      const pos = window.POSITION;
      if (!pos || !pos.units) {
        Alerts.error('You have no ' + MIXER_TICKER + ' to sell');
        return null;
      }
      if (amount > pos.units * 1.0001) {
        Alerts.error('Not enough ' + MIXER_TICKER, {
          detail: 'You hold ' + fmtUnits(pos.units) + ' ' + MIXER_TICKER + '.'
        });
        return null;
      }

      return amount >= pos.units * 0.995 ? 100 : (amount / pos.units) * 100;
    }

    function syncQuickAmounts(context) {
      const row = document.getElementById(context + 'Quick');
      if (!row) return;

      const spec = side === 'buy'
        ? [['0.1', "setAmount('" + context + "',0.1)"],
           ['0.5', "setAmount('" + context + "',0.5)"],
           ['1',   "setAmount('" + context + "',1)"],
           ['MAX', 'setMaxAmount()']]
        : [['25%',  "setPercentAmount('" + context + "',25)"],
           ['50%',  "setPercentAmount('" + context + "',50)"],
           ['75%',  "setPercentAmount('" + context + "',75)"],
           ['100%', "setPercentAmount('" + context + "',100)"]];

      const buttons = row.querySelectorAll('button');
      buttons.forEach(function (b, i) {
        if (!spec[i]) return;
        b.textContent = spec[i][0];
        b.setAttribute('onclick', spec[i][1]);
      });
    }

    function updateUI() {

      const indicator = document.getElementById("tabIndicator");

      const tabBase = "flex-1 py-[7px] rounded-[4px] text-[12.5px] font-semibold transition-colors";
      buyTab.className = side === "buy"
        ? tabBase + " bg-[#16a34a] text-white"
        : tabBase + " text-textSecondary hover:text-white";

      sellTab.className = side === "sell"
        ? tabBase + " bg-[#dc2626] text-white"
        : tabBase + " text-textSecondary hover:text-white";

      if (type === "market") {
        marketContent.classList.remove("hidden");
        limitContent.classList.add("hidden");

        indicator.style.left = "0%";
        marketTab.classList.add("text-white");
        marketTab.classList.remove("text-textSecondary");
        limitTab.classList.add("text-textSecondary");
        limitTab.classList.remove("text-white");

        removeLimitOrderLine();

      } else {
        limitContent.classList.remove("hidden");
        marketContent.classList.add("hidden");

        indicator.style.left = "50%";
        limitTab.classList.add("text-white");
        limitTab.classList.remove("text-textSecondary");
        marketTab.classList.add("text-textSecondary");
        marketTab.classList.remove("text-white");
      }

      syncQuickAmounts("market");
      syncQuickAmounts("limit");
      syncAmountUnit();

      initLimitLogic();
      initButtons();
    }

    let limitLogicBound = false;

    function relabelLimitButton() {
      const limitButton = document.getElementById("limitButton");
      const limitPrice = document.getElementById("limitPrice");
      if (!limitButton || !limitPrice) return;
      const val = parseFloat(limitPrice.value);
      limitButton.textContent = `${side === "buy" ? "Buy" : "Sell"} @ ` +
        (isFinite(val) ? Number(val).toFixed(4) : "—");
    }

    function initLimitLogic() {
      if (limitLogicBound) {
        relabelLimitButton();

        if (type === "limit") {
          const p = parseFloat(document.getElementById("limitPrice").value);
          if (isFinite(p) && p > 0) updateLimitOrderLine(p);
        } else {
          removeLimitOrderLine();
        }
        return;
      }
      limitLogicBound = true;

      const limitPrice = document.getElementById("limitPrice");
      const limitButton = document.getElementById("limitButton");
      const hint = document.getElementById("limitHint");
      if (!limitPrice || !limitButton) return;

      function updateHint(priceVal) {
        if (!hint) return;
        const base = getBasePrice();
        if (!isFinite(priceVal) || priceVal <= 0 || !isFinite(base) || base <= 0) {
          hint.textContent = "";
          return;
        }
        const delta = ((priceVal / base) - 1) * 100;
        const dir = delta >= 0 ? "above" : "below";
        hint.textContent =
          'Fills when the price goes ' + (side === "buy" ? 'down to' : 'up to') +
          ' $' + Number(priceVal).toFixed(4) +
          ' (' + Math.abs(delta).toFixed(1) + '% ' + dir + ' current).';
      }

      function syncFromPrice() {
        const val = parseFloat(limitPrice.value);
        relabelLimitButton();
        updateHint(val);

        if (type !== "limit") { removeLimitOrderLine(); return; }
        if (isFinite(val) && val > 0) updateLimitOrderLine(val);
        else removeLimitOrderLine();
      }

      limitPrice.addEventListener("input", syncFromPrice);
      limitPrice.addEventListener("blur", syncFromPrice);

      limitPrice.addEventListener("change", syncFromPrice);

      const sessionBase = getBasePrice();
      if (isFinite(sessionBase) && sessionBase > 0 && !limitPrice.value) {
        limitPrice.value = sessionBase.toFixed(4);
      }
      syncFromPrice();
    }

    function setAmount(context, val) {
      document.getElementById(context + "Amount").value = val;
    }

    async function setPercentAmount(context, p) {
      const input = document.getElementById(context + "Amount");
      if (!input) return;

      if (side !== 'sell') {
        try {
          const r = await fetch('/wallet/devnet-balance', { headers: { Accept: 'application/json' } });
          const d = await r.json();
          const bal = Math.max(0, Number(d.balance || 0) - 0.025);
          input.value = (bal * (p / 100)).toFixed(4);
          input.dispatchEvent(new Event('input'));
        } catch {  }
        return;
      }

      if (!window.POSITION && window.refreshHoldings) await window.refreshHoldings();
      const pos = window.POSITION;
      if (!pos || !pos.units) {
        Alerts.info('You have no ' + MIXER_TICKER + ' to sell');
        return;
      }

      input.value = String(Math.floor(pos.units * (p / 100) * 1e6) / 1e6);
      input.dispatchEvent(new Event('input'));
    }

    async function setMaxAmount() {
      if (side === 'sell') return setPercentAmount('market', 100);

      const input = document.getElementById('marketAmount');
      const btn = document.getElementById('maxBtn');
      if (!input) return;

      const original = btn ? btn.textContent : '';
      if (btn) btn.textContent = '…';

      try {
        const r = await fetch('/wallet/devnet-balance', { headers: { Accept: 'application/json' } });
        const d = await r.json();
        const bal = Number(d.balance || 0);
        const RESERVE = 0.025;
        input.value = Math.max(0, bal - RESERVE).toFixed(4);
        input.dispatchEvent(new Event('input'));
      } catch (e) {

      } finally {
        if (btn) btn.textContent = original || 'MAX';
      }
    }

    let PNL_POSITION = null;

    let PNL_UNIT = 'USD';
    try {
      const saved = localStorage.getItem('mixer.pnlUnit');
      if (saved === 'USD' || saved === 'SOL') PNL_UNIT = saved;
    } catch {  }

    function togglePnlUnit() {
      PNL_UNIT = PNL_UNIT === 'SOL' ? 'USD' : 'SOL';
      try { localStorage.setItem('mixer.pnlUnit', PNL_UNIT); } catch {  }
      renderPnlStrip();
    }

    function renderPnlStrip() {
      const strip = document.getElementById('pnlStrip');
      if (!strip) return;

      const rate = Number(window.SOL_USD);
      const usable = PNL_UNIT === 'USD' && isFinite(rate) && rate > 0;

      const fmt = function (sol) {
        if (sol == null || !isFinite(Number(sol))) return '—';
        const n = Number(sol);
        const neg = n < 0;
        const mag = Math.abs(n);
        if (usable) {
          const usd = mag * rate;
          return (neg ? '-' : '') + '$' + (usd >= 1 ? usd.toFixed(2) : usd.toFixed(4));
        }
        return (neg ? '-' : '') + mag.toFixed(4);
      };

      const set = function (id, text, colour) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = text;
        if (colour) el.style.color = colour;
      };

      const p = (PNL_POSITION && PNL_POSITION.exists) ? PNL_POSITION : {};

      const GAIN = '#82e58a';
      const LOSS = '#f6465d';
      const FLAT = '#9ca3af';

      const directional = function (v, colour) {
        const n = Number(v);
        return (isFinite(n) && n > 0) ? colour : FLAT;
      };

      set('pnlBought', fmt(p.boughtSol), directional(p.boughtSol, GAIN));
      set('pnlSold', fmt(p.soldSol), directional(p.soldSol, LOSS));

      set('pnlHolding', fmt(p.remainingSol), FLAT);

      const pnl = p.unrealisedPnl;
      const known = pnl != null && isFinite(pnl);
      let pnlColour = FLAT;

      if (!known) {
        set('pnlValue', '—', FLAT);
      } else {
        const up = pnl >= 0;
        pnlColour = up ? GAIN : LOSS;
        const pct = (p.unrealisedPct != null && isFinite(p.unrealisedPct))
          ? ' (' + (up ? '+' : '') + Number(p.unrealisedPct).toFixed(0) + '%)'
          : '';

        set('pnlValue', (up ? '+' : '') + fmt(pnl) + pct, pnlColour);
      }

      const icon = document.querySelector('#pnlUnitToggle i');
      if (icon) icon.style.color = pnlColour;

      const btn = document.getElementById('pnlUnitToggle');
      if (btn) btn.title = 'Showing ' + (usable ? 'USD' : 'SOL') + ' — click to switch';
    }

    window.POSITION = null;

    const POS_SYMBOL = {};
    const POS_LOGO = {};
    ALLOCATIONS.forEach(function (a) {
      const sym = (a.token && (a.token.symbol || a.token.name)) || a.token_address.slice(0, 4);
      [a.mirror_mint, a.token_address].forEach(function (k) {
        if (!k) return;
        POS_SYMBOL[k] = sym;
        POS_LOGO[k] = '/images/tokens/' + a.token_address;
      });
    });

    const POS_GAIN = '#22c55e';
    const POS_LOSS = '#f6465d';
    const POS_FLAT = '#9ca3af';

    function posSet(id, text, colour) {
      const el = document.getElementById(id);
      if (!el) return;
      if (el.textContent !== text) el.textContent = text;
      el.style.color = colour || '';
    }

    function fmtSol(n, dp) {
      return (n == null || !isFinite(n)) ? '—' : Number(n).toFixed(dp == null ? 4 : dp);
    }

    function fmtUnits(n) {
      if (n == null || !isFinite(n)) return '—';
      const a = Math.abs(n);
      const dp = a >= 1000 ? 2 : a >= 1 ? 4 : 6;
      return Number(n).toLocaleString('en-US', { minimumFractionDigits: Math.min(dp, 2), maximumFractionDigits: dp });
    }

    function fmtTokenAmount(raw, decimals) {
      const n = Number(raw) / Math.pow(10, decimals || 0);
      if (!isFinite(n)) return '—';
      const a = Math.abs(n);
      if (a >= 1e9) return (n / 1e9).toFixed(2) + 'B';
      if (a >= 1e6) return (n / 1e6).toFixed(2) + 'M';
      if (a >= 1e3) return n.toLocaleString('en-US', { maximumFractionDigits: 0 });
      if (a >= 1) return n.toFixed(2);
      return n.toPrecision(3);
    }

    function fmtHeld(ms) {
      if (ms == null || !isFinite(ms)) return '—';
      const m = Math.floor(ms / 60000);
      const h = Math.floor(m / 60);
      const d = Math.floor(h / 24);
      return d > 0 ? d + 'd ' + (h % 24) + 'h' : h > 0 ? h + 'h ' + (m % 60) + 'm' : Math.max(1, m) + 'm';
    }

    function signedSol(n) {
      return (n >= 0 ? '+' : '') + Number(n).toFixed(4) + ' SOL';
    }

    let holdingsInFlight = null;

    function refreshHoldings() {
      if (!holdingsInFlight) {
        holdingsInFlight = loadHoldings().finally(function () { holdingsInFlight = null; });
      }
      return holdingsInFlight;
    }

    async function loadHoldings() {
      const panel = document.getElementById('positionPanel');
      const opts = { headers: { Accept: 'application/json' } };

      let v = null, h = null;
      try {
        const res = await Promise.all([
          fetch('/mixer/' + MIXER_ID + '/value', opts),
          fetch('/mixer/' + MIXER_ID + '/my-position', opts),
        ]);
        v = res[0].ok ? await res[0].json() : null;
        h = res[1].ok ? await res[1].json() : null;
      } catch (e) {
        return;
      }

      const held = v && v.exists && Number(v.solValue) > 0;

      if (!held) {
        window.POSITION = null;
        PNL_POSITION = h;
        renderPnlStrip();
        if (!panel) return;

        const sub = document.getElementById('posEmptySub');
        if (sub && h && h.everHeld && h.realisedPnl != null && isFinite(h.realisedPnl)) {
          sub.textContent = 'You sold out of this position with ' +
            signedSol(Number(h.realisedPnl)) + ' realised.';
        }
        panel.dataset.state = 'empty';
        return;
      }

      const sol = Number(v.solValue);
      const units = Number(v.units);
      const cost = (h && h.exists && h.costOfRemaining != null && isFinite(h.costOfRemaining))
        ? Number(h.costOfRemaining)
        : (v.costSol != null ? Number(v.costSol) : null);
      const pnl = cost != null ? sol - cost : null;
      const pnlPct = cost > 0 ? (pnl / cost) * 100 : null;

      window.POSITION = {
        shares: v.shares,
        solValue: sol,
        units: isFinite(units) && units > 0 ? units : null,
      };

      PNL_POSITION = Object.assign({}, h || {}, {
        exists: true, remainingSol: sol, unrealisedPnl: pnl, unrealisedPct: pnlPct,
      });
      renderPnlStrip();

      if (!panel) return;

      posSet('posUnits', fmtUnits(window.POSITION.units));
      posSet('posSol', fmtSol(sol));
      posSet('posUsd', v.usdValue > 0
        ? ' · $' + Number(v.usdValue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        : '');

      if (pnl == null) {
        posSet('posPnl', '—', POS_FLAT);
        posSet('posPnlPct', '—', POS_FLAT);
        posSet('posPnlBasis', ' · no cost basis recorded');
      } else {
        const c = pnl >= 0 ? POS_GAIN : POS_LOSS;
        posSet('posPnl', signedSol(pnl), c);
        posSet('posPnlPct', pnlPct != null ? (pnl >= 0 ? '+' : '') + pnlPct.toFixed(2) + '%' : '—', c);
        posSet('posPnlBasis', ' · on ' + fmtSol(cost) + ' SOL cost');
      }

      const realised = (h && h.realisedPnl != null && isFinite(h.realisedPnl)) ? Number(h.realisedPnl) : null;
      if (realised == null) {
        posSet('posRealised', '—', POS_FLAT);
        posSet('posRealisedSub', 'Nothing sold yet');
      } else {
        posSet('posRealised', signedSol(realised), realised >= 0 ? POS_GAIN : POS_LOSS);
        posSet('posRealisedSub', 'On ' + fmtSol(h.soldSol) + ' SOL sold');
      }

      const own = Number(v.ownershipPct);
      posSet('posOwn', isFinite(own) ? (own < 0.01 ? '<0.01%' : own.toFixed(2) + '%') : '—');
      const bar = document.getElementById('posOwnBar');
      if (bar) bar.style.width = (isFinite(own) ? Math.max(1, Math.min(100, own)) : 0) + '%';

      const legs = (Array.isArray(v.legs) ? v.legs.slice() : [])
        .sort(function (a, b) { return Number(b.solOut) - Number(a.solOut); });
      const body = document.getElementById('posLegs');
      if (body) {
        const html = legs.length ? legs.map(function (l) {
          const legSol = Number(l.solOut) || 0;
          const share = sol > 0 ? (legSol / sol) * 100 : 0;
          const sym = POS_SYMBOL[l.mint] || l.mint.slice(0, 4);
          const logo = POS_LOGO[l.mint] || '';
          return '<tr>' +
            '<td><div class="flex items-center gap-2 min-w-0">' +
              '<img src="' + logo + '" alt="" loading="lazy" class="w-5 h-5 rounded-full bg-[#16171D] shrink-0">' +
              '<span class="text-white font-medium truncate">' + sym + '</span></div></td>' +
            '<td><div class="flex items-center gap-2">' +
              '<div class="flex-1 h-[5px] rounded-full bg-[#1a1d23] overflow-hidden">' +
                '<div class="h-full rounded-full" style="width:' + share.toFixed(1) + '%;background:#7453E2"></div></div>' +
              '<span class="text-gray-400 w-[44px] text-right">' + share.toFixed(1) + '%</span></div></td>' +
            '<td class="text-right text-gray-300">' + fmtTokenAmount(l.tokensOut, l.decimals) + '</td>' +
            '<td class="text-right"><span class="text-white">' + legSol.toFixed(4) + '</span>' +
              ' <span class="text-gray-500">SOL</span></td>' +
            '</tr>';
        }).join('') : '<tr><td colspan="4" class="text-center text-gray-500">No holdings to break down.</td></tr>';
        if (body.dataset.html !== html) {
          body.innerHTML = html;
          body.dataset.html = html;
        }
      }

      const avgBuyUsd = h && h.avgBuyPriceUsd != null && isFinite(h.avgBuyPriceUsd)
        ? Number(h.avgBuyPriceUsd) : null;
      posSet('posAvgBuy', avgBuyUsd != null
        ? '$' + avgBuyUsd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 })
        : '—');
      posSet('posCost', cost != null ? fmtSol(cost) + ' SOL' : '—');
      posSet('posBought', h && h.boughtSol != null ? fmtSol(h.boughtSol) + ' SOL' : '—');
      posSet('posSold', h && Number(h.soldSol) > 0 ? fmtSol(h.soldSol) + ' SOL' : '—');
      posSet('posHeld', fmtHeld(h && h.heldMs));
      posSet('posTrades', h && h.tradeCount != null ? String(h.tradeCount) : '—');

      panel.dataset.state = 'held';
    }

    window.refreshHoldings = refreshHoldings;

    window.refreshPosition = refreshHoldings;
    refreshHoldings();

    (function memeCountdown() {
      const chip = document.getElementById('memeChip');
      if (!chip) return;

      const text = document.getElementById('memeChipText');
      const expiresAt = Number(chip.dataset.expires);
      if (!isFinite(expiresAt)) return;

      let reloaded = false;

      function fmt(ms) {
        const s = Math.max(0, Math.floor(ms / 1000));
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        if (d > 0) return d + 'd ' + h + 'h';
        if (h > 0) return h + 'h ' + String(m).padStart(2, '0') + 'm';
        if (m > 0) return m + 'm ' + String(sec).padStart(2, '0') + 's';
        return sec + 's';
      }

      function tick() {
        const left = expiresAt - Date.now();

        if (left <= 0) {
          chip.classList.remove('is-soon', 'is-urgent');
          chip.classList.add('is-done');
          if (text) text.textContent = chip.dataset.state === 'settled' ? 'Settled' : 'Settling…';

          if (!reloaded && chip.dataset.state === 'live') {
            reloaded = true;
            setTimeout(function () { window.location.reload(); }, 4000);
          }
          return;
        }

        if (text) text.textContent = fmt(left);
        chip.classList.toggle('is-soon', left <= 3600000 && left > 300000);
        chip.classList.toggle('is-urgent', left <= 300000);
      }

      tick();
      setInterval(tick, 1000);
    })();

    setInterval(function () {
      if (document.visibilityState === 'visible') refreshHoldings();
    }, 120000);

    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') refreshHoldings();
    });

    function offsetLimit(pct) {
      const priceEl = document.getElementById('live-mixer-price');
      const base = priceEl ? parseFloat(String(priceEl.innerText).replace(/[^0-9eE.+-]/g, '')) : NaN;
      if (!isFinite(base) || base <= 0) return;

      const target = base * (1 + pct / 100);
      const input = document.getElementById('limitPrice');
      if (input) {
        input.value = target >= 0.01 ? target.toFixed(4) : target.toPrecision(4);
        input.dispatchEvent(new Event('input'));
      }
    }

    (function () {
      if (READINESS.tradeable) return;

      ['marketButton', 'limitButton'].forEach(function (id) {
        const b = document.getElementById(id);
        if (!b) return;
        b.disabled = true;
        b.textContent = READINESS.state === 'unpriceable' ? 'Not tradeable' : 'Pricing…';
        b.title = READINESS.reason || '';
      });
      ['marketAmount', 'limitAmount', 'limitPrice'].forEach(function (id) {
        const i = document.getElementById(id);
        if (i) i.disabled = true;
      });

      if (READINESS.state === 'pricing') {
        setTimeout(function () { window.location.reload(); }, 30000);
      }
    })();

    function initButtons() {

      const marketButton = document.getElementById("marketButton");
      const limitButton = document.getElementById("limitButton");

      if (!READINESS.tradeable) {
        marketButton.textContent = READINESS.state === 'unpriceable' ? 'Not tradeable' : 'Pricing…';
        marketButton.disabled = true;
        marketButton.className =
          'h-[42px] w-full rounded-[5px] text-[13px] font-semibold bg-[#2a2d34] text-textTertiary cursor-not-allowed';
      } else {
        marketButton.textContent = side === "buy" ? "Buy Market" : "Sell Market";
        marketButton.disabled = false;
        marketButton.className =
          'h-[42px] w-full rounded-[5px] text-[13px] font-semibold transition-colors ' +
          (side === "buy" ? 'bg-[#16a34a] hover:bg-[#15803d]' : 'bg-[#dc2626] hover:bg-[#b91c1c]');
      }

      marketButton.onclick = () => {
        const amount = parseFloat(document.getElementById("marketAmount").value);
        if (!amount || amount <= 0) {
          return Alerts.error(side === 'sell' ? 'Enter how much ' + MIXER_TICKER + ' to sell' : 'Enter an amount of SOL');
        }
        if (side === "sell") {

          const percent = unitsToPercent(amount);
          if (percent == null) return;
          return runSell({ units: Math.min(amount, window.POSITION.units), percent: percent, ticker: MIXER_TICKER });
        }
        runPurchase(amount);
      };

      limitButton.onclick = () => {
        var amount = parseFloat(document.getElementById("limitAmount").value);
        var price = parseFloat(document.getElementById("limitPrice").value);
        if (!amount || amount <= 0) {
          return Alerts.error(side === 'sell' ? 'Enter how much ' + MIXER_TICKER + ' to sell' : 'Enter an amount of SOL');
        }

        if (side === 'sell') {
          amount = unitsToPercent(amount);
          if (amount == null) return;
        }

        window.MixerLive.placeLimitOrder(side, amount, price);
      };
    }

    buyTab.onclick = () => {
      side = "buy";
      updateUI();

      if (type === "limit") {
        setTimeout(() => {
          const limitPrice = document.getElementById("limitPrice");
          if (limitPrice && limitPrice.value) {
            updateLimitOrderLine(parseFloat(limitPrice.value));
          }
        }, 100);
      }
    };

    sellTab.onclick = () => {
      side = "sell";
      updateUI();

      if (type === "limit") {
        setTimeout(() => {
          const limitPrice = document.getElementById("limitPrice");
          if (limitPrice && limitPrice.value) {
            updateLimitOrderLine(parseFloat(limitPrice.value));
          }
        }, 100);
      }
    };

    marketTab.onclick = () => { type = "market"; updateUI(); };
    limitTab.onclick = () => { type = "limit"; updateUI(); };

    updateUI();

  </script>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/alerts.js"></script>
  <script src="/js/trademodal.js"></script>
  <script src="/js/purchase.js"></script>
  <script src="/js/mixerlive.js"></script>

  <%- include('partials/xcard') %>
</body>

</html>
