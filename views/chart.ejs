            <div id="tab-performance" class="tab-content hidden p-4">
              <div id="performance-chart-container" class="bg-[#0B0D10] border border-gray-800 rounded-lg w-full" style="height: 500px;"></div>

              <div class="mt-4 flex items-center justify-between">
                <div>
                  <h3 class="text-sm font-semibold text-white mb-1">Token Performance</h3>
