            <% if (hasLineage) { %>
            <div id="tab-theses" class="tab-content hidden p-4">
              <%
                function fmtSolC(v) {
                  var n = Number(v) || 0;
                  if (n === 0) return '0';
                  if (n >= 1000) return (n / 1000).toFixed(1) + 'k';
                  if (n >= 1) return n.toFixed(2);
                  return n.toFixed(4);
                }
                function agoDate(ts) {
                  if (!ts) return '—';
                  return new Date(ts).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
                }
                var comp = (typeof competing !== 'undefined' && competing) ? competing : [];
                var par = (typeof parentMixer !== 'undefined' && parentMixer) ? parentMixer : null;
              %>

              <div class="rounded-xl border border-[#21262d] bg-[#101317] p-5 mb-4">
                <div class="flex items-start justify-between gap-4 mb-2">
                  <div class="min-w-0">
                    <span class="text-[10px] uppercase tracking-wider text-[#a78bfa] font-bold">
                      <%= mixer.parent_mixer_id ? 'This remix argues' : 'The thesis' %>
                    </span>
                    <h3 class="text-lg font-bold text-white mt-1">
                      <%= mixer.thesis_title || mixer.name %>
                    </h3>
                  </div>
                  <a href="/mixer/<%= mixer.mixer_id %>/remix"
                     class="shrink-0 text-[11px] font-semibold px-3 py-1.5 rounded-lg bg-[#7453E2]/15 border border-[#7453E2]/40 text-[#a78bfa] hover:bg-[#7453E2] hover:text-white transition-colors">
                    Disagree? Remix it
                  </a>
                </div>

                <% if (mixer.thesis) { %>
                  <p class="text-sm text-gray-300 leading-relaxed whitespace-pre-line"><%= mixer.thesis %></p>
                <% } else { %>
                  <p class="text-sm text-gray-600 italic">No thesis was written for this mixer.</p>
                <% } %>
                <%
                  var tabSiteHost = null;
                  try {
                    if (mixer.website && /^https?:\/\//i.test(mixer.website)) {
                      tabSiteHost = new URL(mixer.website).hostname.replace(/^www\./, '');
                    }
                  } catch (e) { tabSiteHost = null; }
                %>
                <% if (tabSiteHost) { %>
                  <a href="<%= mixer.website %>" target="_blank" rel="noopener noreferrer nofollow ugc"
                     class="thesis-site mt-3" title="<%= mixer.website %>">
                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                    <span class="truncate">Read more on <%= tabSiteHost %></span>
                    <span aria-hidden="true">&#8599;</span>
                  </a>
                <% } %>

                <% if (mixer.counter_thesis) { %>
                  <div class="mt-4 pt-4 border-t border-[#21262d]">
                    <span class="text-[10px] uppercase tracking-wider text-gray-500 font-bold">
                      Why <%= creatorHandle ? '@' + creatorHandle : 'the creator' %> disagreed with
                      <%= mixer.parent_name || 'the original' %>
                    </span>
                    <p class="text-sm text-gray-300 leading-relaxed whitespace-pre-line mt-1.5"><%= mixer.counter_thesis %></p>
                  </div>
                <% } %>

                <% if (mixer.parent_mixer_id || mixer.parent_name) { %>
                  <p class="text-[11px] text-gray-500 mt-4 pt-3 border-t border-[#21262d] leading-relaxed">
                    Remixed from
                    <% if (mixer.parent_mixer_id) { %>
                      <a href="/mixer/<%= mixer.parent_mixer_id %>" class="text-[#a78bfa] hover:underline"><%= mixer.parent_name || 'the original' %></a><% } else { %><%= mixer.parent_name %><% } %>.
                    This is an independent mixer with its own vault and investors, and the
                    original creator has not endorsed it.
                  </p>
                <% } %>

                <div class="mt-4 pt-3 border-t border-[#21262d] flex items-center gap-4 text-[11px] text-gray-500">
                  <span>Since <%= agoDate(mixer.created_at) %></span>
                  <% if (par) { %>
                    <a href="/mixer/<%= mixer.mixer_id %>/compare/<%= par.mixer_id %>"
                       class="text-[#a78bfa] hover:underline font-medium">Compare with the original →</a>
                  <% } %>
                </div>
              </div>

              <% if (comp.length) { %>
                <h4 class="text-sm font-semibold text-white mb-1">Competing theses</h4>
