<%

  function fmtPrice(v) {
    var n = Number(v);
    if (!isFinite(n) || n <= 0) return '0';
    if (n >= 1) return n.toFixed(2);
    if (n >= 0.01) return n.toFixed(4);
    if (n >= 0.000001) return n.toFixed(8).replace(/0+$/, '');
    return n.toExponential(2);
  }
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= mixer.name %> - Trading</title>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.2.2/dist/lightweight-charts.standalone.production.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      background: #0b0d10;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* The creator's "read more" link under a thesis. */
    .thesis-site {
      display: inline-flex; align-items: center; gap: 5px;
      max-width: 100%;
      font-size: 11.5px; font-weight: 600;
      color: #a78bfa;
      transition: color .15s ease;
    }
    .thesis-site:hover { color: #fff; }

    /* ---- Meme mode countdown ----
       Written as real CSS rather than Tailwind utilities: these classes are
       toggled from JS as the clock crosses thresholds, and the Tailwind CDN
       only generates classes it can see in the static HTML at load. A utility
       that appears solely inside a JS string is never emitted, so toggling it
       silently does nothing.
       Warm, like the /meme page: a meme run should never read as a mixer. */
    .meme-chip {
      border: 1px solid rgba(255, 176, 32, .45);
      background: rgba(255, 176, 32, .12);
      color: #ffcf66;
      font-variant-numeric: tabular-nums;
      transition: color .2s ease, border-color .2s ease, background .2s ease;
    }
    /* Under an hour: this is now a countdown, not a date. */
    .meme-chip.is-soon {
      border-color: rgba(234, 179, 8, .5);
      background: rgba(234, 179, 8, .14);
      color: #fde047;
    }
    /* Under five minutes: pulses so it is noticeable in peripheral vision. */
    .meme-chip.is-urgent {
      border-color: rgba(246, 70, 93, .55);
      background: rgba(246, 70, 93, .16);
      color: #ff8a9b;
      animation: memePulse 1s ease-in-out infinite;
    }
    .meme-chip.is-done {
      border-color: #2C2C2C;
      background: rgba(255, 255, 255, .04);
      color: #7d8590;
      animation: none;
    }
    @keyframes memePulse {
      0%, 100% { opacity: 1; }
      50%      { opacity: .55; }
    }
    /* Respect a reduced-motion preference: the colour still conveys urgency. */
    @media (prefers-reduced-motion: reduce) {
      .meme-chip.is-urgent { animation: none; }
    }

    /* Hide scrollbar but keep functionality */
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    /* Children of a scrolling flex column keep their own height instead of
       shrinking to fit it -- the chart's height is set explicitly and must
       not be squeezed when the tabs below it are long. */
    .col-scroll > * { flex-shrink: 0; }

    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Resizable chart container */
    .resizable-chart {
      position: relative;
      min-height: 300px;
      height: 450px;
    }

    /* Chart Height Adjuster - Separate visible div */
    .chart-adjuster {
        height: 7px;
        background: #1e1e1e;
        cursor: ns-resize;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

    .chart-adjuster:hover {
      background: #7453E2;
    }

    .chart-adjuster::after {
      content: '⋮';
      color: #8B949E;
      font-size: 20px;
      letter-spacing: 2px;
      transform: rotate(90deg);
    }

    .chart-adjuster:hover::after {
      color: #fff;
    }

    /* Tab styles */
    .tab-button {
      transition: all 0.2s;
    }
    .tab-button.active {
      color: #7453E2;
      border-bottom: 2px solid #7453E2;
    }
    .tab-button:hover {
      color: #C9D1D9;
    }

    /* Price display */
    .price-positive {
      color: #22c55e;
    }
    .price-negative {
      color: #f6465d;
    }
    /* Applied by the timeframe row for an unknown change. It had no rule, so
       a dash inherited whatever colour was in scope. */
    .price-neutral {
      color: #9aa0a6;
    }

    /* Value that just changed, briefly lit so a moving number is noticed
       without having to watch for it. */
    .stat-flash {
      animation: statFlash .6s ease-out;
    }
    @keyframes statFlash {
      from { background-color: rgba(116, 83, 226, .35); }
      to   { background-color: transparent; }
    }
    @media (prefers-reduced-motion: reduce) {
      .stat-flash { animation: none; }
    }

    /* Performance chart legend */
    .performance-legend-item {
      padding: 6px 10px;
      background: #0b0d10;
      border: 1px solid #21262d;
      border-radius: 6px;
      transition: all 0.2s;
      cursor: pointer;
    }

    .performance-legend-item:hover {
      border-color: #7453E2;
    }

    /* Stat box styling */
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
      padding: 2px 4px;
    }

    .stat-label {
      font-size: 12px;
      font-weight: 400;
      line-height: 16px;
      color: #8B949E;
    }

    .stat-value {
      font-size: 13px;
      font-weight: 400;
      line-height: 17px;
      color: #e4e4e7;
      font-variant-numeric: tabular-nums;
    }

	.pie-chart-container {
		display: flex;
		justify-content: center;
		height: 250px;
	}

	.token-allocation-row {
		background-color: #16171D;
	}

	.token-name {
		display: flex;
		font-size: 13.5px;
	}

	.token-verified {
		position: relative;
    	top: 2.4px;
    	color: #82e58a;
    	left: 0.3rem;
	}

	.token-address {
		font-size: 12.5px;
		display: flex;
		align-items: center;
		gap: 5px;
	}

	.token-price {
		font-size: 13.5px;
		font-weight: 600;
	}

	.token-percentage {
		font-size: 12px;
	}

	/* Copy / explorer controls next to the mint address. Kept dim until the
	   row is hovered so the list still reads as a clean column of tokens. */
	.token-addr-action {
		color: #6b7280;
		opacity: 0;
		transition: opacity .15s, color .15s;
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	.token-allocation-row:hover .token-addr-action {
		opacity: 1;
	}

	.token-addr-action:hover {
		color: #fff;
	}

	.token-addr-action.copied {
		opacity: 1;
		color: #82e58a;
	}

	.footer-title {
		font-size: 18px;
		font-weight: 500;
	}

	/* Competing-thesis cards. Same visual language as the .fund-card rows on
	   /mixers, so a basket looks like a basket wherever it appears. */
	.fund-card-t {
		background: #14171c;
		border: 1px solid #21262d;
		border-radius: 12px;
		padding: 12px;
		cursor: pointer;
		transition: background .15s ease, border-color .15s ease;
	}
	.fund-card-t:hover { background: #191d24; border-color: #2f3742; }

	/* ===== Competition panel =====
	   Hand-written rather than Tailwind utilities because several of these
	   classes are applied to markup that JS rebuilds or toggles, and the Play
	   CDN only compiles classes present in the static HTML at load. */

	.comp-card {
		border: 1px solid #1f242c;
		border-radius: 7px;
		background: #0f1216;
		padding: 9px 10px;
	}
	.comp-card-btn {
		display: block;
		cursor: pointer;
		transition: border-color .15s ease, background .15s ease;
	}
	.comp-card-btn:hover { border-color: rgba(116, 83, 226, .5); background: #12151b; }

	.comp-eyebrow {
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: .06em;
		text-transform: uppercase;
		color: #6b7280;
	}

	/* The clamp is what makes "View more" mean something. Three lines is the
	   most a 300px column can carry before it stops being scannable. */
	.comp-body {
		font-size: 11.5px;
		line-height: 1.55;
		color: #a8b0ba;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.comp-more {
		margin-top: 7px;
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-size: 10.5px;
		font-weight: 600;
		color: #a78bfa;
		transition: color .15s ease;
	}
	.comp-more:hover { color: #c4b5fd; }

	.comp-link {
		font-size: 10.5px;
		font-weight: 600;
		color: #a78bfa;
	}

	/* Rank chip. Gold only for an actual lead -- if every state glows, none
	   of them signals anything. */
	.comp-rank {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: .04em;
		text-transform: uppercase;
		padding: 2px 6px;
		border-radius: 4px;
		color: #9aa0a6;
		background: rgba(255, 255, 255, .04);
		border: 1px solid #23272f;
	}
	.comp-rank.is-leader {
		color: #facc15;
		background: rgba(250, 204, 21, .1);
		border-color: rgba(250, 204, 21, .32);
	}

	/* Standings rows */
	.comp-row {
		display: flex;
		align-items: center;
		gap: 6px;
		width: 100%;
		padding: 5px 10px;
		border-top: 1px solid #191d23;
		transition: background .12s ease;
	}
	.comp-row:hover { background: #151920; }
	.comp-row.is-me { background: rgba(116, 83, 226, .09); }
	.comp-row.is-me:hover { background: rgba(116, 83, 226, .15); }
	.comp-row-all { justify-content: center; }

	.comp-pos {
		width: 15px;
		flex-shrink: 0;
		font-size: 10px;
		font-weight: 700;
		text-align: center;
		color: #5a616b;
		font-variant-numeric: tabular-nums;
	}
	.comp-pos.is-first { color: #facc15; }

	.comp-name {
		font-size: 11.5px;
		color: #d1d5db;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 130px;
	}
	.comp-row.is-me .comp-name { color: #fff; font-weight: 600; }

	.comp-tag {
		flex-shrink: 0;
		font-size: 8.5px;
		font-weight: 700;
		letter-spacing: .05em;
		padding: 1px 3px;
		border-radius: 3px;
		color: #7d8590;
		background: rgba(255, 255, 255, .05);
	}

	.comp-chg { font-size: 11px; font-weight: 600; flex-shrink: 0; }

	.comp-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 8px 10px;
		border-radius: 7px;
		border: 1px dashed rgba(116, 83, 226, .45);
		background: rgba(116, 83, 226, .07);
		font-size: 11.5px;
		font-weight: 600;
		color: #a78bfa;
		text-align: center;
		transition: background .15s ease, border-color .15s ease, color .15s ease;
	}
	.comp-cta:hover {
		background: rgba(116, 83, 226, .16);
		border-color: rgba(116, 83, 226, .8);
		border-style: solid;
		color: #c4b5fd;
	}

	/* Thesis modal: the full narrative, with room to actually read it. */
	#thesisModal { display: none; }
	#thesisModal.is-open { display: flex; }

	/* ===== Chart toolbar =====
	   Hand-written because the popovers are toggled from JS, and the Tailwind
	   Play CDN only compiles classes it can see in the static HTML. */

	.chart-toolbar {
		display: flex;
		align-items: center;
		gap: 2px;
		height: 36px;
		padding: 0 8px;
		background: #0b0d10;
		border-bottom: 1px solid #21262d;
	}

	.ct-sep {
		width: 1px;
		height: 16px;
		margin: 0 6px;
		background: #21262d;
	}

	.ct-menu { position: relative; }

	.ct-trigger {
		display: flex;
		align-items: center;
		gap: 4px;
		height: 24px;
		padding: 0 7px;
		border-radius: 4px;
		font-size: 12px;
		font-weight: 600;
		color: #c9d1d9;
		transition: background .12s ease, color .12s ease;
	}
	.ct-trigger:hover { background: #1c2128; color: #fff; }
	.ct-trigger.is-open { background: #1c2128; color: #fff; }

	.ct-glyph { width: 15px; height: 15px; flex-shrink: 0; }
	.ct-caret { width: 10px; height: 10px; flex-shrink: 0; opacity: .5; }

	.ct-pop {
		display: none;
		position: absolute;
		top: calc(100% + 5px);
		left: 0;
		z-index: 60;
		min-width: 168px;
		padding: 4px;
		border-radius: 7px;
		border: 1px solid #2c333d;
		background: #14181e;
		box-shadow: 0 10px 28px rgba(0, 0, 0, .6);
	}
	.ct-pop.is-open { display: block; }

	.ct-group {
		padding: 6px 8px 3px;
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: .06em;
		text-transform: uppercase;
		color: #6b7280;
	}

	.ct-item {
		display: block;
		width: 100%;
		padding: 6px 8px;
		border-radius: 4px;
		text-align: left;
		font-size: 12px;
		color: #c9d1d9;
		white-space: nowrap;
		transition: background .1s ease, color .1s ease;
	}
	.ct-item:hover { background: #222a33; color: #fff; }

	/* The active row is filled, matching the reference: a checkmark is easy
	   to miss at this size, a filled row is not. */
	.ct-item.is-active { background: #2563eb; color: #fff; }
	.ct-item.is-active:hover { background: #2563eb; }

	.ct-item-icon { display: flex; align-items: center; gap: 8px; }

	.ct-brand {
		margin-left: auto;
		padding-right: 2px;
		font-size: 10.5px;
		font-weight: 500;
		color: #4b525c;
		letter-spacing: .01em;
		user-select: none;
		white-space: nowrap;
	}

	.mixer-name {
		font-size: 18px;
		font-weight: 500;
	}

	.mixer-ticker {
		position: relative;
		font-size: 17px;
		color: #62677c;
		font-weight: 500;
	}

	.mixer-ticker:hover {
		color: #787b88;
	}

	/* ---- Your Position tab ---- */
	.pos-panel > .pos-loading, .pos-panel > .pos-empty, .pos-panel > .pos-held { display: none; }
	.pos-panel[data-state="loading"] > .pos-loading { display: block; }
	.pos-panel[data-state="empty"]   > .pos-empty   { display: flex; }
	.pos-panel[data-state="held"]    > .pos-held    { display: block; }
	.pos-panel[data-state="loading"] > .pos-orders  { display: none; }
	.pos-kpi { display: flex; flex-direction: column; gap: 3px; padding: 14px 16px; border-right: 1px solid #21262d; min-width: 0; }
	.pos-kpi:last-child { border-right: 0; }
	.pos-label { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: #6b7280; font-weight: 600; }
	.pos-value { font-size: 17px; font-weight: 600; color: #fff; font-variant-numeric: tabular-nums; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.pos-unit { font-size: 12px; color: #9ca3af; font-weight: 500; }
	.pos-sub { font-size: 11px; color: #7d8590; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.pos-bar { display: block; height: 4px; margin-top: 6px; border-radius: 999px; background: #1a1d23; overflow: hidden; }
	.pos-bar > span { display: block; height: 100%; background: #7453E2; border-radius: 999px; transition: width .3s ease; }
	.pos-section-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 16px 8px; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: #9ca3af; font-weight: 600; }
	.pos-table th { padding: 6px 16px; font-size: 10px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid #21262d; }
	.pos-table td { padding: 9px 16px; font-size: 12px; border-bottom: 1px solid #161a20; font-variant-numeric: tabular-nums; }
	.pos-table tr:last-child td { border-bottom: 0; }
	.pos-dl { padding: 0 16px 10px; }
	.pos-dl > div { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid #161a20; font-size: 12px; }
	.pos-dl > div:last-child { border-bottom: 0; }
	.pos-dl dt { color: #7d8590; }
	.pos-dl dd { color: #e5e7eb; font-variant-numeric: tabular-nums; text-align: right; }

	.mixer-image {
		border: 3px solid #7453e2;
    	border-radius: 6px;
	}

	.timeframe-container {
		display: flex;
		width: 100%;
		height: 3.8rem;
    border-bottom: 1px solid #1f2937;
	}

	/* .timeframe-container sets display:flex, and this stylesheet is parsed
	   after the Tailwind CDN, so a bare .hidden would lose the tie on equal
	   specificity and the element would never actually hide. */
	.timeframe-container.hidden {
		display: none;
	}

	.timeframe-text {
		font-size: 13px;
		font-weight: 500;
		color: #8B949E;
	}

	.bg-primaryStroke {
      background: #1f232e;
    }

    .border-primaryStroke {
      border-color: #23272f;
    }

    .border-secondaryStroke {
      border-color: #23272f;
    }

    .text-textPrimary {
      color: #ffffff;
    }

    .text-textTertiary {
      color: #7c8596;
    }

    .text-textSecondary {
      color: #9ca3af;
    }

    .bg-primaryBlue {
      background: #7453e2;
    }

    .price-positive {
      color: #82e58a;
    }

    .price-negative {
      color: #f6465d;
    }

    /* Gain/loss tokens for the position strip.
       Hand-written like the rest of this block: chart.ejs has no
       tailwind.config, so these names only exist because they are defined
       here. Matching the green already used by .price-positive and the red by
       .price-negative, so one colour means one thing across the page. */
    .text-increase {
      color: #82e58a;
    }

    .text-decrease {
      color: #f6465d;
    }

    .text-increaseHover {
      color: #a0f0a7;
    }

    .hover\:text-increaseHover:hover {
      color: #a0f0a7;
    }

    /* The CDN cannot build a hover variant of a class it does not know about
       (chart.ejs has no tailwind.config), so the ones this page relies on are
       written out. */
    .hover\:bg-primaryStroke:hover {
      background: #1f232e;
    }

    .hover\:bg-primaryStrokeHalf:hover {
      background: rgba(31, 35, 46, .5);
    }

    .group:hover .group-hover\:text-textSecondary {
      color: #9ca3af;
    }

    .group:hover .group-hover\:text-increaseHover {
      color: #a0f0a7;
    }

    /* A flat or unknown figure is neither a gain nor a loss. */
    .text-flat {
      color: #9ca3af;
    }

	.user_X {
		transition: all 0.2s ease-in-out;
	}

	.user_X:hover  {
		text-decoration: underline;
	}
  </style>
</head>
<body class="bg-[#0b0d10] text-gray-200 h-screen flex flex-col overflow-hidden">

  <%- include('partials/appnav', { user: user, active: '' }) %>

  <div class="flex-1 min-h-0 overflow-hidden">
    <div class="flex h-full">

      <div class="flex-1 min-w-0 flex flex-col overflow-y-auto hide-scrollbar col-scroll">

        <div class="flex max-h-[80px] min-h-[80px] flex-row items-center justify-start gap-5 border-b border-[#21262d] pl-4 pr-4 bg-[#0b0d10] sticky top-0 z-10">

          <div class="flex flex-shrink-0 flex-row items-center justify-center gap-2.5">
            <img src="<%= (mixer.image && mixer.image.trim()) ? mixer.image : '/images/tokens/' + (allocations[0] ? allocations[0].token_address : 'none') %>"
                 alt="<%= mixer.ticker %>" class="w-11 h-11 mixer-image object-cover">
            <div class="flex flex-col items-start justify-start gap-0">
              <div class="flex items-center gap-1">
                <span class="mixer-name leading-5 tracking-[-0.02em] text-white"><%= mixer.name %></span>
                <span class="mixer-ticker ml-1">
                  <%= mixer.ticker %>
                  <button type="button" style="padding-top: 1.3px;" title="Copy mixer address"
                          onclick="copyToClipboard('<%= mixer.mixer_id %>')">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><g clip-path="url(#clip0_11927_145082)"><path d="M5.3335 5.3335V3.46683C5.3335 2.72009 5.3335 2.34672 5.47882 2.06151C5.60665 1.81063 5.81063 1.60665 6.06151 1.47882C6.34672 1.3335 6.72009 1.3335 7.46683 1.3335H12.5335C13.2802 1.3335 13.6536 1.3335 13.9388 1.47882C14.1897 1.60665 14.3937 1.81063 14.5215 2.06151C14.6668 2.34672 14.6668 2.72009 14.6668 3.46683V8.5335C14.6668 9.28023 14.6668 9.6536 14.5215 9.93882C14.3937 10.1897 14.1897 10.3937 13.9388 10.5215C13.6536 10.6668 13.2802 10.6668 12.5335 10.6668H10.6668M3.46683 14.6668H8.5335C9.28023 14.6668 9.6536 14.6668 9.93882 14.5215C10.1897 14.3937 10.3937 14.1897 10.5215 13.9388C10.6668 13.6536 10.6668 13.2802 10.6668 12.5335V7.46683C10.6668 6.72009 10.6668 6.34672 10.5215 6.06151C10.3937 5.81063 10.1897 5.60665 9.93882 5.47882C9.6536 5.3335 9.28023 5.3335 8.5335 5.3335H3.46683C2.72009 5.3335 2.34672 5.3335 2.06151 5.47882C1.81063 5.60665 1.60665 5.81063 1.47882 6.06151C1.3335 6.34672 1.3335 6.72009 1.3335 7.46683V12.5335C1.3335 13.2802 1.3335 13.6536 1.47882 13.9388C1.60665 14.1897 1.81063 14.3937 2.06151 14.5215C2.34672 14.6668 2.72009 14.6668 3.46683 14.6668Z" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"></path></g><defs><clipPath id="clip0_11927_145082"><rect width="16" height="16" fill="white"></rect></clipPath></defs></svg>
                  </button>

                  <button type="button" style="padding-top: 1.3px;" title="Share this mixer"
                          id="shareBtn" onclick="shareMixer(this)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                      <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                      <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/>
                    </svg>
                  </button>
                </span>
                <a href="/mixer/<%= mixer.mixer_id %>/info"
                   class="text-[11px] px-2 py-0.5 rounded-md bg-white/5 border border-[#21262d] text-gray-400 hover:text-white hover:border-[#7453E2] transition-colors ml-1">Stats</a>

                <% if (typeof memeLife !== 'undefined' && memeLife) { %>

                  <span id="memeChip"
                        class="meme-chip ml-1 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-bold"
                        data-state="<%= memeLife.state %>"
                        data-expires="<%= memeLife.expiresAt %>">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
                    </svg>
                    <span id="memeChipText">—</span>
                  </span>
                <% } %>
              </div>
              <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                <span class="text-[11px] text-[#7d8590]"><%= allocations.length %> assets</span>
                <span class="text-[11px] text-[#3d434b]">·</span>
                <%

                  var ageText = '';
                  if (mixer.created_at) {
                    var ageMs = Date.now() - new Date(mixer.created_at).getTime();
                    var mins = Math.floor(ageMs / 60000);
                    var hrs = Math.floor(mins / 60);
                    var days = Math.floor(hrs / 24);
                    var mos = Math.floor(days / 30);
                    var yrs = Math.floor(days / 365);
                    if (yrs >= 1) ageText = yrs + 'y ago';
                    else if (mos >= 1) ageText = mos + 'mo ago';
                    else if (days >= 1) ageText = days + 'd ago';
                    else if (hrs >= 1) ageText = hrs + 'h ago';
                    else ageText = Math.max(1, mins) + 'm ago';
                  }
                %>
                <span class="text-[11px] font-medium" style="color:#22c55e"><%= ageText %></span>

                <% if (typeof creatorHandle !== 'undefined' && creatorHandle) { %>
                  <span class="text-[11px] text-[#3d434b]">·</span>

                  <a class="user_X text-[11px] text-[#2fbaff] font-medium"
                     data-xcard="<%= creatorHandle %>"
                     href="https://x.com/<%= creatorHandle %>" target="_blank" rel="noopener">@<%= creatorHandle %></a>
                <% } %>

                <%

                  var hasSir = typeof sir !== 'undefined' && sir !== null;
                  var hasSirBase = typeof sirBase !== 'undefined' && sirBase !== null;
                %>
                <%

                  var sirTip = 'SIR (Since Inception Return)';
                  if (hasSirBase) {
                    sirTip += ' — created at $' + fmtPrice(sirBase);
                  }
                %>
                <% if (hasSir || hasSirBase) { %>
                  <span class="text-[11px] text-[#3d434b]">·</span>
                  <span id="sir-stat" class="text-[11px] font-semibold cursor-help"
                        style="color:<%= !hasSir ? '#9ca3af' : sir >= 0 ? '#22c55e' : '#f6465d' %>"
                        data-tip="<%= sirTip %>"
                        aria-label="Since Inception Return"><%= hasSir ? (sir >= 0 ? '+' : '') + Number(sir).toFixed(2) + '%' : '—' %></span>
                <% } %>

                <% if (mixer.parent_mixer_id || mixer.parent_name) { %>
                  <span class="text-[10px] font-bold px-1.5 py-[1px] rounded"
                        style="color:#a78bfa;background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.32)">
                    REMIXED
                  </span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="stat-item">
            <span class="stat-label">Price</span>

            <span class="stat-value" style="font-size: 18px;"><%= (typeof mixerPrice !== 'undefined' && mixerPrice) ? '$' : '' %><span id="live-mixer-price"><%= (typeof mixerPrice !== 'undefined' && mixerPrice) ? fmtPrice(mixerPrice) : '—' %></span></span>
          </div>

          <div class="stat-item">
            <span class="stat-label">24h</span>
            <%
              var c24 = null;
              try { c24 = timeframes.timeframes['24h'].change_percent; } catch (e) {}
              var c24cls = c24 === null || c24 === undefined ? '' : (c24 > 0 ? 'price-positive' : (c24 < 0 ? 'price-negative' : ''));
            %>
            <span class="stat-value <%= c24cls %>" id="change-24h-stat">
              <%= (c24 === null || c24 === undefined) ? '0.00%' : ((c24 >= 0 ? '+' : '') + Number(c24).toFixed(2) + '%') %>
            </span>
          </div>

          <div class="stat-item">
            <span class="stat-label">Volume 24h</span>
            <span class="stat-value"><span id="volume-24h"><%= (typeof stats !== 'undefined' && stats && stats.volume24h) ? Number(stats.volume24h).toFixed(3) : '0.000' %></span> <span class="text-[#7d8590] text-[11px]">SOL</span></span>
          </div>

          <div class="stat-item">
            <span class="stat-label">Holders</span>
            <span class="stat-value"><span id="holders-stat"><%= (typeof stats !== 'undefined' && stats && stats.holders != null) ? stats.holders : 0 %></span></span>
          </div>

          <div class="stat-item">
            <span class="stat-label">Risk Score</span>
            <span class="stat-value">
              <% if (typeof riskScore !== 'undefined' && riskScore !== null) { %>
                <%
                  var rsBand = riskScore <= 35 ? { label: 'Low risk', colour: '#22c55e' }
                             : riskScore <= 60 ? { label: 'Medium risk', colour: '#eab308' }
                             : { label: 'High risk', colour: '#f6465d' };
                  var rsTitle = rsBand.label + ' (' + riskScore + '/100, lower is safer)';
                  var rsRugged = (typeof riskDetail !== 'undefined' && riskDetail && riskDetail.rugged) || [];
                  if (rsRugged.length) {
                    rsTitle += ' — flagged as rugged: ' + rsRugged.join(', ');
                  }
                  if (typeof riskCoverage !== 'undefined' && riskCoverage > 0 && riskCoverage < 100) {
                    rsTitle += ' — rated across ' + riskCoverage + '% of the basket';
                  }
                %>
                <span id="risk-stat" class="font-bold" style="color: <%= rsBand.colour %>"
                      title="<%= rsTitle %>"><%= riskScore %><% if (rsRugged.length) { %> <span aria-label="Contains a token flagged as rugged">&#9888;</span><% } %></span>
              <% } else { %>
                <span id="risk-stat" class="text-[#5a616b]" title="No constituent could be rated">&mdash;</span>
              <% } %>
            </span>
          </div>

          <a href="/mixer/<%= mixer.mixer_id %>/remix"
             class="ml-auto shrink-0 inline-flex items-center gap-1.5 px-3 py-[7px] rounded-lg
                    text-[12px] font-semibold bg-[#7453E2]/12 border border-[#7453E2]/40
                    text-[#a78bfa] hover:bg-[#7453E2] hover:text-white hover:border-[#7453E2]
                    transition-colors"
             title="Disagree with this basket? Build your own version of it.">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 3h5v5"/><path d="M4 20L21 3"/><path d="M21 16v5h-5"/>
              <path d="M15 15l6 6"/><path d="M4 4l5 5"/>
            </svg>
            Remix
          </a>
        </div>

        <div class="chart-toolbar">

          <div class="ct-menu" id="tfMenu">
            <button type="button" class="ct-trigger" id="tfTrigger"
                    aria-haspopup="listbox" aria-expanded="false">
              <span id="tfLabel">15s</span>
              <svg class="ct-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>

            <div class="ct-pop" id="tfPop" role="listbox" aria-label="Interval">
              <div class="ct-group">Seconds</div>
              <button type="button" class="ct-item" role="option" data-tf="15">15 seconds</button>
              <button type="button" class="ct-item" role="option" data-tf="30">30 seconds</button>
              <div class="ct-group">Minutes</div>
              <button type="button" class="ct-item" role="option" data-tf="60">1 minute</button>
              <button type="button" class="ct-item" role="option" data-tf="300">5 minutes</button>
              <button type="button" class="ct-item" role="option" data-tf="900">15 minutes</button>
              <button type="button" class="ct-item" role="option" data-tf="1800">30 minutes</button>
              <div class="ct-group">Hours</div>
              <button type="button" class="ct-item" role="option" data-tf="3600">1 hour</button>
              <button type="button" class="ct-item" role="option" data-tf="14400">4 hours</button>
            </div>
          </div>

          <span class="ct-sep"></span>

          <div class="ct-menu" id="styleMenu">
            <button type="button" class="ct-trigger" id="styleTrigger"
                    aria-haspopup="listbox" aria-expanded="false" data-tip="Chart style">
              <svg id="styleIcon" class="ct-glyph" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 4v16M7 8h3V16H7zM17 4v16M14 7h3v9h-3z"/>
              </svg>
              <svg class="ct-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>

            <div class="ct-pop" id="stylePop" role="listbox" aria-label="Chart style">
              <button type="button" class="ct-item ct-item-icon" role="option" data-style="candles">
                <svg class="ct-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 4v16M7 8h3V16H7zM17 4v16M14 7h3v9h-3z"/>
                </svg>
                Candles
              </button>
              <button type="button" class="ct-item ct-item-icon" role="option" data-style="hollow">
                <svg class="ct-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 4v16M7 8h3V16H7zM17 4v16M14 7h3v9h-3z"/>
                </svg>
                Hollow candles
              </button>
              <button type="button" class="ct-item ct-item-icon" role="option" data-style="bars">
                <svg class="ct-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 4v16M8 9H5M8 14h3M16 4v16M16 8h3M16 15h-3"/>
                </svg>
                Bars
              </button>
              <button type="button" class="ct-item ct-item-icon" role="option" data-style="line">
                <svg class="ct-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 17l5-6 4 3 4-6 5 5"/>
                </svg>
                Line
              </button>
              <button type="button" class="ct-item ct-item-icon" role="option" data-style="area">
                <svg class="ct-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 17l5-6 4 3 4-6 5 5"/><path d="M3 17v3h18v-3" opacity=".55"/>
                </svg>
                Area
              </button>
            </div>
          </div>

          <span class="ct-brand"><%= mixer.ticker %> on mixer.fund</span>
        </div>

        <div class="resizable-chart bg-[#0B0D10] relative" id="chart-container">
          <div id="chart-root" class="w-full h-full"></div>
        </div>

        <div class="chart-adjuster" id="chart-adjuster"></div>

        <div class="bg-[#0B0D10]">

          <div class="flex border-b border-gray-800 bg-[#0b0d10]">
            <button onclick="switchTab('orders')" class="tab-button active px-6 py-3 text-sm font-medium text-gray-400" data-tab="orders">
              Transactions
            </button>
            <button onclick="switchTab('position')" class="tab-button px-6 py-3 text-sm font-medium text-gray-400" data-tab="position">
              Your Position
            </button>
            <button onclick="switchTab('holders')" class="tab-button px-6 py-3 text-sm font-medium text-gray-400" data-tab="holders">
              Holders
            </button>
            <button onclick="switchTab('allocations')" class="tab-button px-6 py-3 text-sm font-medium text-gray-400" data-tab="allocations">
              Allocations
            </button>
            <button onclick="switchTab('performance')" class="tab-button px-6 py-3 text-sm font-medium text-gray-400" data-tab="performance">
              Token Performance
            </button>
            <%

              var hasLineage = (typeof competing !== 'undefined' && competing && competing.length)
                            || mixer.parent_mixer_id || mixer.thesis || mixer.thesis_title;
            %>
            <% if (hasLineage) { %>
              <button onclick="switchTab('theses')" class="tab-button px-6 py-3 text-sm font-medium text-gray-400" data-tab="theses">
                Thesis<% if (typeof competing !== 'undefined' && competing && competing.length) { %>
                  <span class="ml-1.5 text-[10px] px-1.5 py-0.5 rounded bg-[#7453E2]/20 text-[#a78bfa]"><%= competing.length %></span>
                <% } %>
              </button>
            <% } %>
          </div>

          <div>

            <div id="tab-orders" class="tab-content">

              <div class="flex w-full flex-row px-4 h-8 items-center border-b border-[#21262d] sticky top-0 bg-[#0b0d10] z-10">
                <div class="w-[60px] shrink-0"><span class="text-[10px] uppercase tracking-wider text-gray-500 font-semibold">Age</span></div>
                <div class="w-[44px] shrink-0"><span class="text-[10px] uppercase tracking-wider text-gray-500 font-semibold">Type</span></div>
                <div class="flex-1 text-right"><span class="text-[10px] uppercase tracking-wider text-gray-500 font-semibold">Price</span></div>
                <div class="flex-1 text-right"><span class="text-[10px] uppercase tracking-wider text-gray-500 font-semibold">Amount</span></div>
                <div class="flex-1 text-right"><span class="text-[10px] uppercase tracking-wider text-gray-500 font-semibold">Total USD</span></div>
                <div class="w-[104px] shrink-0 text-right"><span class="text-[10px] uppercase tracking-wider text-gray-500 font-semibold">Trader</span></div>
                <div class="w-[22px] shrink-0"></div>
              </div>

              <div id="liveTradeLog" class="overflow-y-auto" style="max-height:420px">
                <div class="px-4 py-8 text-center text-xs text-gray-500">Loading trades…</div>
              </div>
            </div>

            <div id="tab-position" class="tab-content hidden">
              <div id="positionPanel" class="pos-panel" data-state="loading">

                <div class="pos-loading px-4 py-10 text-center text-xs text-gray-500">Loading your position…</div>

                <div class="pos-empty px-6 py-12 flex-col items-center text-center">
                  <img src="<%= (mixer.image && mixer.image.trim()) ? mixer.image : '/images/tokens/' + (allocations[0] ? allocations[0].token_address : 'none') %>" alt="" class="w-10 h-10 rounded-full object-cover opacity-60 mb-3">
                  <p class="text-[13px] font-semibold text-white">You don't hold <%= mixer.ticker %> yet</p>
                  <p id="posEmptySub" class="text-[12px] text-gray-500 mt-1 max-w-[340px] leading-relaxed">
                    Once you buy, your stake, profit and loss, and what it's made of show up here.
                  </p>
                  <button type="button" onclick="focusBuy()"
                    class="mt-4 h-[32px] px-4 rounded-[5px] text-[12px] font-semibold bg-[#16a34a] hover:bg-[#15803d] text-white transition-colors">
                    Buy <%= mixer.ticker %>
                  </button>
                </div>

                <div class="pos-held">

                  <div class="grid grid-cols-2 lg:grid-cols-4 border-b border-[#21262d]">
                    <div class="pos-kpi">
                      <span class="pos-label">Holding</span>
                      <span class="pos-value"><span id="posUnits">—</span> <span class="pos-unit"><%= mixer.ticker %></span></span>
                      <span class="pos-sub"><span id="posSol">—</span> SOL<span id="posUsd"></span></span>
                    </div>
                    <div class="pos-kpi">
                      <span class="pos-label">Unrealised P/L</span>
                      <span id="posPnl" class="pos-value">—</span>
                      <span class="pos-sub"><span id="posPnlPct" class="font-semibold">—</span><span id="posPnlBasis"></span></span>
                    </div>
                    <div class="pos-kpi">
                      <span class="pos-label">Realised P/L</span>
                      <span id="posRealised" class="pos-value">—</span>
                      <span id="posRealisedSub" class="pos-sub">Nothing sold yet</span>
                    </div>
                    <div class="pos-kpi">
                      <span class="pos-label">Share of fund</span>
                      <span id="posOwn" class="pos-value">—</span>
                      <span class="pos-bar"><span id="posOwnBar" style="width:0%"></span></span>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 lg:grid-cols-[1.7fr_1fr]">

                    <div class="lg:border-r border-[#21262d] min-w-0">
                      <div class="pos-section-head">
                        <span>Composition</span>
                        <span class="text-gray-600 normal-case tracking-normal font-normal">Valued at live prices</span>
                      </div>
                      <table class="w-full pos-table">
                        <thead>
                          <tr>
                            <th class="text-left">Token</th>
                            <th class="text-left w-[38%]">Share of position</th>
                            <th class="text-right">Amount</th>
                            <th class="text-right">Value</th>
                          </tr>
                        </thead>
                        <tbody id="posLegs"></tbody>
                      </table>
                    </div>

                    <div class="min-w-0">
                      <div class="pos-section-head"><span>Details</span></div>
                      <dl class="pos-dl">
                        <div><dt>Avg. buy price</dt><dd id="posAvgBuy">—</dd></div>
                        <div><dt>Cost of holding</dt><dd id="posCost">—</dd></div>
                        <div><dt>Total bought</dt><dd id="posBought">—</dd></div>
                        <div><dt>Total sold</dt><dd id="posSold">—</dd></div>
                        <div><dt>Held for</dt><dd id="posHeld">—</dd></div>
                        <div><dt>Trades</dt><dd id="posTrades">—</dd></div>
                      </dl>
                    </div>
                  </div>
                </div>

                <div class="pos-orders border-t border-[#21262d]">
                  <div class="pos-section-head"><span>Limit orders</span></div>
                  <div id="limitOrdersList" class="px-4 pb-4"></div>
                </div>
              </div>
            </div>

            <div id="tab-holders" class="tab-content hidden p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-semibold">Holders</h3>
                <span class="text-xs text-gray-500"><span id="holdersCount">0</span> on chain</span>
              </div>

              <div id="holdersList" class="space-y-2 overflow-y-auto" style="max-height:420px">
                <p class="text-xs text-gray-500">Loading holders…</p>
              </div>
            </div>

            <div id="tab-allocations" class="tab-content hidden p-4">
              <div class="grid grid-cols-3 gap-4">
                <div class="col-span-2">
                  <h3 class="footer-title font-semibold mb-3">Token Allocations</h3>
                  <div class="space-y-2">
                    <% allocations.forEach((a, index) => { %>
                    <div class="bg-[#16171D] rounded-lg p-3.5 hover:bg-[#1d1e25] transition token-allocation-row">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                          <img src="/images/tokens/<%= a.token_address %>" alt="<%= a.token?.symbol || '' %>" class="w-8 h-8 rounded-full bg-[#0b0d10]" loading="lazy">
                          <div style="padding-left: 6px;">
                            <p class="token-name font-semibold text-white">
								<%= a.token?.name || 'Token ' + (index + 1) %>
