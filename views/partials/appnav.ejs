<%

  var navUser = typeof user !== 'undefined' ? user : null;
  var navActive = typeof active !== 'undefined' ? active : '';
%>
<nav class="bg-[#0b0d10] border-b border-gray-800 relative z-50">
  <div class="max-w-full px-4 py-2.5">
    <div class="flex items-center justify-between">

      <div class="flex items-center gap-6">
