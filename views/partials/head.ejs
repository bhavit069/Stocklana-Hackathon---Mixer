<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof title !== 'undefined' && title) ? title + ' · Mixer' : 'Mixer' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#0B0D10',
                        surface: '#111317',
                        input: '#0D0F12',

                        primary: '#7453E2',
                        textSecondary: '#9AA0A6'
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        /* Backdrop: a soft brand glow behind the card and a faint grid that
           fades out toward the edges. Decorative only, never interactive. */
        .auth-backdrop {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            background:
                radial-gradient(640px 320px at 50% -60px, rgba(116, 83, 226, .30), transparent 70%),
                radial-gradient(520px 300px at 88% 105%, rgba(116, 83, 226, .10), transparent 70%);
        }

        .auth-backdrop::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px);
            background-size: 44px 44px;
            -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 28%, #000 25%, transparent 75%);
            mask-image: radial-gradient(ellipse 70% 55% at 50% 28%, #000 25%, transparent 75%);
        }

        /* Every auth card gets the same finish: a hairline top highlight so it
           lifts off the backdrop. */
        main>.bg-surface {
            box-shadow: 0 1px 0 rgba(255, 255, 255, .06) inset, 0 30px 80px -24px rgba(0, 0, 0, .75);
            border-color: rgba(255, 255, 255, .07) !important;
        }
    </style>
</head>

<body class="bg-background text-white min-h-screen flex flex-col">
    <div class="auth-backdrop" aria-hidden="true"></div>

