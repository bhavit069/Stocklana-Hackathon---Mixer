<%- include('partials/head', { title: 'Sign in' }) %>

    <div class="w-full max-w-[400px] bg-surface rounded-2xl border px-8 py-7 relative overflow-hidden">

        <div class="absolute -top-px left-1/2 -translate-x-1/2 w-2/3 h-px bg-gradient-to-r from-transparent via-primary to-transparent opacity-70"></div>

        <div class="mb-7 text-center">
            <h1 class="text-[26px] font-semibold tracking-tight text-white">Welcome back</h1>
            <p class="text-textSecondary mt-1.5 text-sm">Sign in to build, trade and track your mixers.</p>
        </div>

        <% if (error) { %>
            <div class="flex items-start gap-2 bg-red-500/10 border border-red-500/20 text-red-300 px-3.5 py-3 rounded-xl mb-6 text-sm" role="alert">
                <svg class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01" stroke-linecap="round"/>
                </svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <button type="button" id="connectWalletBtn"
            class="group flex items-center justify-center w-full bg-primary hover:bg-[#6344d1] text-white font-semibold py-3.5 rounded-xl transition-all gap-2.5 shadow-lg shadow-primary/25 active:scale-[0.985] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-surface">
            <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" />
                <path d="M3 5v14a2 2 0 0 0 2 2h16v-5" />
                <path d="M18 12a2 2 0 0 0 0 4h4v-4Z" />
            </svg>
            <span>Connect Wallet</span>
        </button>

        <p id="walletHint" class="mt-3 text-center text-[12px] text-textSecondary/80 min-h-[18px]">
            Phantom, Solflare, Backpack and other Solana wallets
        </p>

        <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-white/[0.07]"></div>
            </div>
            <div class="relative flex justify-center">
                <span class="bg-surface px-3 text-[11px] uppercase tracking-[0.12em] text-textSecondary/70">or with email</span>
            </div>
        </div>

        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label for="email" class="block text-xs font-medium text-textSecondary mb-1.5">Email</label>
                <input id="email" type="email" name="email" required autocomplete="email"
                    class="w-full bg-input border border-white/[0.08] rounded-xl px-4 py-3 text-white text-[15px] focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/25 transition-all placeholder-gray-600"
                    placeholder="you@example.com">
            </div>
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label for="password" class="block text-xs font-medium text-textSecondary">Password</label>
                    <a href="/forgot-password" class="text-xs text-[#a78bfa] hover:text-white transition-colors">Forgot?</a>
                </div>
                <input id="password" type="password" name="password" required autocomplete="current-password"
                    class="w-full bg-input border border-white/[0.08] rounded-xl px-4 py-3 text-white text-[15px] focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/25 transition-all placeholder-gray-600"
                    placeholder="••••••••">
            </div>

            <button type="submit"
                class="w-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.09] text-white font-medium py-3 rounded-xl transition-all active:scale-[0.985] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">
                Sign in
            </button>
        </form>

        <p class="mt-6 text-center text-sm text-textSecondary">
            New to Mixer? <a href="/register" class="text-[#a78bfa] hover:text-white transition-colors font-medium">Create an account</a>
        </p>
    </div>

    <script src="/js/walletAuth.js"></script>
    <script>
        (function () {
            var btn = document.getElementById('connectWalletBtn');
            var hint = document.getElementById('walletHint');

            btn.addEventListener('click', function () {
                window.MixerWallet.openPicker();
            });

            window.addEventListener('load', function () {
                setTimeout(function () {
                    var found = window.MixerWallet.listWallets().installed;
                    if (!found.length) return;
                    var names = found.map(function (w) { return w.name; });
                    hint.textContent = names.length === 1
                        ? names[0] + ' detected'
                        : names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1] + ' detected';
                }, 400);
            });
        })();
    </script>

<%- include('partials/footer') %>
