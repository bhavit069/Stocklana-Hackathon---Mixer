<%

  function fmtPrice(v) {
    var n = Number(v);
    if (!isFinite(n) || n <= 0) return '0.00';
    if (n >= 1) return n.toFixed(2);
    if (n >= 0.01) return n.toFixed(4);
    if (n >= 0.000001) return n.toFixed(8).replace(/0+$/, '');
    return n.toExponential(2);
  }
%>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profile.creator.username %> · Creator</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: '#0b0d10', surface: '#15161A', stroke: '#2C2C2C',
            primary: '#7453E2', textSecondary: '#9AA0A6'
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>

<body class="bg-background text-white min-h-screen">

  <%- include('partials/appnav', { user: user, active: '' }) %>

    <%
      var c = profile.creator;
      var t = profile.totals;
      function shortAddr(a) { return a ? a.slice(0, 6) + '…' + a.slice(-6) : '—'; }

      function fmtLamports(l) {
        var n = (Number(l) || 0) / 1e9;
        if (n === 0) return '0';
        return n.toFixed(n >= 1 ? 4 : 6).replace(/\.?0+$/, '');
      }
    %>

    <div class="max-w-5xl mx-auto px-4 py-8">

      <div class="bg-surface border border-stroke rounded-2xl p-6 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center gap-5">

          <% if (c.xProfilePicture) { %>
            <img src="<%= c.xProfilePicture %>" alt="" class="w-20 h-20 rounded-2xl object-cover border border-stroke shrink-0">
          <% } else { %>
            <div class="w-20 h-20 rounded-2xl bg-primary/15 border border-primary/25 flex items-center justify-center text-primary font-bold text-3xl shrink-0">
              <%= (c.username || '?').charAt(0).toUpperCase() %>
            </div>
          <% } %>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <h1 class="text-2xl font-bold tracking-tight truncate"><%= c.username %></h1>
              <% if (isSelf) { %>
                <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-1 rounded-md bg-primary/15 border border-primary/30 text-primary">You</span>
              <% } %>
            </div>

            <% if (c.xUsername) { %>
              <a href="https://x.com/<%= c.xUsername %>" target="_blank" rel="noopener"
                class="inline-flex items-center gap-1.5 text-sm text-gray-300 hover:text-white transition-colors group">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231z" />
                </svg>
                <span class="group-hover:underline">@<%= c.xUsername %></span>
              </a>
            <% } else if (isSelf) { %>
              <a href="/link/x"
                class="inline-flex items-center gap-1.5 text-sm text-textSecondary hover:text-white transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231z" />
                </svg>
                Link your X account
              </a>
            <% } else { %>
              <span class="text-sm text-textSecondary">No X account linked</span>
            <% } %>

            <div class="flex items-center gap-4 mt-3 text-xs text-textSecondary flex-wrap">
              <span>Joined <%= new Date(c.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
              <% if (c.walletAddress) { %>
                <a href="https://explorer.solana.com/address/<%= c.walletAddress %>?cluster=devnet" target="_blank"
                  rel="noopener" class="font-mono hover:text-white hover:underline"><%= shortAddr(c.walletAddress) %></a>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-surface border border-stroke rounded-2xl p-5">
          <p class="text-[10px] uppercase tracking-wider text-textSecondary font-semibold mb-2">Mixers created</p>
          <p class="text-2xl font-semibold tabular-nums"><%= profile.mixers.length %></p>
        </div>
        <div class="bg-surface border border-stroke rounded-2xl p-5">
          <p class="text-[10px] uppercase tracking-wider text-textSecondary font-semibold mb-2">Volume driven</p>
          <p class="text-2xl font-semibold tabular-nums"><%= t.volumeSol.toFixed(4) %></p>
          <p class="text-xs text-textSecondary mt-1">SOL</p>
        </div>
        <div class="bg-surface border border-stroke rounded-2xl p-5">
          <p class="text-[10px] uppercase tracking-wider text-textSecondary font-semibold mb-2">Holders</p>
          <p class="text-2xl font-semibold tabular-nums"><%= t.holders %></p>
          <p class="text-xs text-textSecondary mt-1">across all mixers</p>
        </div>
        <div class="bg-surface border border-stroke rounded-2xl p-5">
          <p class="text-[10px] uppercase tracking-wider text-textSecondary font-semibold mb-2">Trades</p>
          <p class="text-2xl font-semibold tabular-nums"><%= t.tradeCount %></p>
          <p class="text-xs text-textSecondary mt-1"><%= t.uniqueTraders %> unique</p>
        </div>
      </div>

      <% if (isSelf) { %>
        <% var fees = profile.fees; %>
        <section class="bg-surface border border-stroke rounded-2xl overflow-hidden mb-6" id="feesPanel">
          <div class="px-6 py-4 border-b border-stroke">
            <h2 class="text-lg font-semibold">Creator fees</h2>
            <p class="text-xs text-textSecondary mt-0.5">
              You earn a share of the fee on every trade in your mixers, paid out in SOL.
            </p>
          </div>

          <% if (!fees) { %>
            <p class="px-6 py-8 text-sm text-textSecondary text-center">
              Your fees could not be read right now. Refresh in a moment.
            </p>
          <% } else { %>
            <div class="px-6 py-5 flex flex-wrap items-center justify-between gap-5">
              <div class="flex flex-wrap items-end gap-x-10 gap-y-4">
                <div>
                  <p class="text-[11px] uppercase tracking-wider text-textSecondary font-semibold">Available to claim</p>
                  <p class="text-3xl font-bold tabular-nums mt-1 <%= fees.claimableLamports > 0 ? 'text-green-400' : '' %>" id="feesAvailable">
                    <%= fmtLamports(fees.claimableLamports) %> <span class="text-base font-semibold text-textSecondary">SOL</span>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase tracking-wider text-textSecondary font-semibold">Claimed so far</p>
                  <p class="text-lg font-semibold tabular-nums mt-1 text-gray-300" id="feesClaimed">
                    <%= fmtLamports(fees.claimedLamports) %> <span class="text-sm text-textSecondary">SOL</span>
                  </p>
                </div>
              </div>

              <button type="button" id="claimFees"
                class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-xl text-sm font-semibold transition-colors bg-primary hover:bg-[#6344d1] disabled:bg-white/[0.06] disabled:text-textSecondary disabled:cursor-not-allowed"
                <%= fees.claimableLamports > 0 ? '' : 'disabled' %>>
                <span id="claimLabel">Claim fees</span>
              </button>
            </div>

            <% var rows = fees.mixers.filter(function (m) { return m.claimableLamports > 0 || m.claimedLamports > 0 || m.note; }); %>
            <% if (!rows.length) { %>
              <p class="px-6 pb-6 text-sm text-textSecondary">
                No fees yet. They build up as people trade your mixers.
              </p>
            <% } else { %>
              <div class="overflow-x-auto border-t border-stroke">
                <table class="w-full text-sm">
                  <thead class="bg-black/30 text-textSecondary">
                    <tr>
                      <th class="text-left font-semibold px-6 py-3 text-[11px] uppercase tracking-wider">Mixer</th>
                      <th class="text-right font-semibold px-6 py-3 text-[11px] uppercase tracking-wider">Available</th>
                      <th class="text-right font-semibold px-6 py-3 text-[11px] uppercase tracking-wider">Claimed</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% rows.forEach(function (m) { %>
                      <tr class="border-t border-stroke" data-fee-row="<%= m.mixerId %>">
                        <td class="px-6 py-3">
                          <a href="/mixer/<%= m.mixerId %>" class="hover:text-primary hover:underline"><%= m.name %></a>
                          <span class="text-textSecondary text-xs ml-1">$<%= m.ticker %></span>
                          <% if (m.note) { %><p class="text-[11px] text-yellow-500/80 mt-0.5"><%= m.note %></p><% } %>
                        </td>
                        <td class="px-6 py-3 text-right tabular-nums <%= m.claimableLamports > 0 ? 'text-green-400' : 'text-textSecondary' %>" data-fee-available>
                          <%= fmtLamports(m.claimableLamports) %>
                        </td>
                        <td class="px-6 py-3 text-right tabular-nums text-textSecondary" data-fee-claimed>
                          <%= fmtLamports(m.claimedLamports) %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          <% } %>
        </section>
      <% } %>

      <section>
        <h2 class="text-lg font-semibold mb-4">Mixers by <%= c.username %></h2>

        <% if (!profile.mixers.length) { %>
          <div class="border border-stroke border-dashed rounded-2xl py-14 px-6 text-center">
            <p class="text-textSecondary text-sm <%= isSelf ? 'mb-5' : '' %>">No mixers created yet.</p>
            <% if (isSelf) { %>
              <a href="/mixer/create"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary hover:bg-[#6344d1] text-sm font-semibold rounded-lg transition-colors">
                Create your first mixer
              </a>
            <% } %>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% profile.mixers.forEach(function (m) { %>
              <a href="/mixer/<%= m.mixer_id %>/info"
                class="block bg-surface border border-stroke rounded-2xl p-5 hover:border-primary/60 transition-all">
                <div class="flex items-center gap-3 mb-4 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-primary/15 border border-primary/25 flex items-center justify-center text-primary font-bold shrink-0">
                    <%= (m.ticker || m.name || '?').charAt(0).toUpperCase() %>
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold truncate leading-tight"><%= m.name || 'Untitled' %></p>
                    <p class="text-xs text-textSecondary font-mono"><%= m.ticker || '—' %></p>
                  </div>
                </div>
                <div class="flex items-end justify-between">
                  <div>
                    <p class="text-[10px] uppercase tracking-wider text-textSecondary font-semibold mb-1">Price</p>
                    <p class="text-lg font-semibold tabular-nums">
                      <%= m.price != null ? '$' + fmtPrice(m.price) : 'no price' %>
                    </p>
                  </div>
                  <span class="text-xs text-textSecondary"><%= new Date(m.created_at).toLocaleDateString() %></span>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>

    <script src="/js/alerts.js"></script>
    <script>
      (function () {
        var btn = document.getElementById('claimFees');
        if (!btn) return;
        var label = document.getElementById('claimLabel');

        function fmt(l) {
          var n = (Number(l) || 0) / 1e9;
          if (n === 0) return '0';
          return n.toFixed(n >= 1 ? 4 : 6).replace(/\.?0+$/, '');
        }

        function paint(fees) {
          if (!fees) return;
          var avail = document.getElementById('feesAvailable');
          avail.firstChild.nodeValue = fmt(fees.claimableLamports) + ' ';
          avail.classList.toggle('text-green-400', fees.claimableLamports > 0);
          document.getElementById('feesClaimed').firstChild.nodeValue = fmt(fees.claimedLamports) + ' ';
          fees.mixers.forEach(function (m) {
            var row = document.querySelector('[data-fee-row="' + m.mixerId + '"]');
            if (!row) return;
            var a = row.querySelector('[data-fee-available]');
            a.textContent = fmt(m.claimableLamports);
            a.classList.toggle('text-green-400', m.claimableLamports > 0);
            a.classList.toggle('text-textSecondary', !(m.claimableLamports > 0));
            row.querySelector('[data-fee-claimed]').textContent = fmt(m.claimedLamports);
          });
          btn.disabled = !(fees.claimableLamports > 0);
        }

        btn.addEventListener('click', async function () {
          btn.disabled = true;
          label.textContent = 'Claiming…';

          try {
            var r = await fetch('/creator/claim', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: '{}'
            });
            var b = await r.json().catch(function () { return {}; });
            if (!r.ok) throw new Error(b.error || 'The claim did not go through');

            Alerts.success('You just claimed ' + fmt(b.lamports) + ' SOL in creator fees', {
              detail: 'Sent to your wallet.' + (b.partial ? ' Some fees could not be claimed this time; try again shortly.' : ''),
              html: '<a href="' + b.explorer + '" target="_blank" rel="noopener" style="color:#a78bfa;text-decoration:underline">View transaction</a>',
              timeout: 8000
            });
            paint(b.fees);
            label.textContent = 'Claim fees';
          } catch (err) {
            Alerts.error('Could not claim your fees', { detail: err.message });
            label.textContent = 'Claim fees';
            btn.disabled = false;
          }
        });
      })();
    </script>

</body>

</html>
